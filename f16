-- Ядро выполнения реконнекта
DoRejoin = function(reason: string?)
    if isTeleporting or IsTerminated then return end
    isTeleporting = true
    
    local targetReason = reason or "Таймер"
    print(string.format("[AutoRejoin] Запуск реконнекта (%s)...", targetReason))
    UpdateStatus("Реконнект (" .. targetReason .. ")...", Color3.fromRGB(255, 200, 100))

    pcall(function()
        GuiService:ClearError()
    end)
    
    local success = false
    if SETTINGS.RejoinServerMode == "Same" and typeof(game.JobId) == "string" and game.JobId ~= "" then
        UpdateStatus("Переход на текущий сервер (JobId)...", Color3.fromRGB(150, 200, 255))
        local ok, err = pcall(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
        end)
        if ok then
            success = true
        else
            warn("[AutoRejoin] Не удалось отправить запрос на тот же сервер: " .. tostring(err))
        end
    end
    
    if not success then
        UpdateStatus("Переход на случайный сервер...", Color3.fromRGB(150, 200, 255))
        pcall(function()
            TeleportService:Teleport(game.PlaceId, LocalPlayer)
        end)
    end
    
    task.delay(10, function()
        isTeleporting = false
    end)
end

