-- Вспомогательная быстрая проверка видимости сумки игрока (fallback при старте скрипта посреди раунда)
local function CheckBagGuiVisible(): boolean
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return false end
    local mainGui = playerGui:FindFirstChild("MainGUI")
    if not mainGui or not mainGui:IsA("ScreenGui") or not mainGui.Enabled then return false end

    local gameObj = mainGui:FindFirstChild("Game")
    local gameBags = gameObj and gameObj:FindFirstChild("CoinBags")
    local dock = mainGui:FindFirstChild("Lobby") and mainGui.Lobby:FindFirstChild("Dock")
    local dockBags = dock and dock:FindFirstChild("CoinBags")

    local bagContainer = (gameBags and gameBags:FindFirstChild("Container")) or (dockBags and dockBags:FindFirstChild("Container"))
    if not bagContainer then
        local anyBags = mainGui:FindFirstChild("CoinBags", true)
        bagContainer = anyBags and anyBags:FindFirstChild("Container")
    end

    if not bagContainer or not bagContainer:IsA("GuiObject") or not bagContainer.Visible then
        return false
    end

    -- Проверяем предков контейнера
    local curr: Instance? = bagContainer.Parent
    while curr and curr:IsA("GuiObject") do
        if not curr.Visible then return false end
        if curr:IsA("CanvasGroup") and curr.GroupTransparency >= 1 then return false end
        curr = curr.Parent
    end

    if bagContainer.AbsoluteSize.X <= 0 or bagContainer.AbsoluteSize.Y <= 0 then
        return false
    end

    -- Строгая проверка: ищем реально активную сумку с видимым текстом баланса монет (Coins)
    for _, bag in ipairs(bagContainer:GetChildren()) do
        if bag:IsA("GuiObject") and bag.Visible and bag.AbsoluteSize.X > 0 and bag.AbsoluteSize.Y > 0 then
            local currFrame = bag:FindFirstChild("CurrencyFrame")
            local icon = currFrame and currFrame:FindFirstChild("Icon")
            local coinsLabel = icon and icon:FindFirstChild("Coins")
            if coinsLabel and coinsLabel:IsA("TextLabel") and coinsLabel.Visible and coinsLabel.TextTransparency < 1 then
                return true
            end
        end
    end

    return false
end

function rt:CheckIfPlayerWasInARound(): boolean
    if not rt:Map() then return false end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end

    -- Строгая серверная проверка (если уже получены сетевые пакеты):
    -- true  -> Мёртв (Dead = true)
    -- false -> В раунде и жив (Dead = false)
    local cachedStatus = PlayerAliveCache[LocalPlayer.Name]
    if cachedStatus ~= nil then
        return cachedStatus == false
    end

    -- Проверка физического переноса персонажа на карту (к Spawns карты, а не в лобби)
    local spawnPos = GetMapSpawnPosition()
    if spawnPos then
        local hrp = char.PrimaryPart or char:FindFirstChild("HumanoidRootPart") :: BasePart?
        if hrp and (hrp.Position - spawnPos).Magnitude < 250 then
            PlayerAliveCache[LocalPlayer.Name] = false
            return true
        end
    end

    -- nil -> Ремоуты ещё не стреляли (скрипт запущен посреди уже идущего раунда).
    -- Выполняем лёгкий fallback через видимость сумки на экране (CoinBags.Visible).
    if CheckBagGuiVisible() then
        PlayerAliveCache[LocalPlayer.Name] = false
        return true
    end

    return false
end

function rt:IsElite(): boolean
    return self.player:GetAttribute("Elite") == true
end

local function RoundInProgress(): boolean
    return rt:CheckIfGameInProgress()
end

-- === ГЛОБАЛЬНЫЕ СЕТЕВЫЕ СЛУШАТЕЛИ РАУНДА ===
local function SetupRemoteHooks()
    local giveWeapon = FindRemoteEvent("GiveWeapon")
    if giveWeapon then
        RegisterConnection(giveWeapon.OnClientEvent:Connect(function(wName)
            if IsTerminated then return end
            if CurrentState == State.Action and (SETTINGS.RoundMode == "Assassin" or SETTINGS.RoundMode == "Clear") then
                InspectAndEquipKnife()
            end
        end))
    end

    local roleSelect = FindRemoteEvent("RoleSelect")
    if roleSelect then
        RegisterConnection(roleSelect.OnClientEvent:Connect(function(role)
            if IsTerminated then return end
            DoForceCheckMap()
            if role then
                PlayerRolesCache[LocalPlayer.Name] = tostring(role)
            end
        end))
    end

    local roundStart = FindRemoteEvent("RoundStart")
    if roundStart then
        RegisterConnection(roundStart.OnClientEvent:Connect(function(_, playersData)
            if IsTerminated then return end
            table.clear(PlayerAliveCache)
            table.clear(PlayerRolesCache)
            DoForceCheckMap()
            if typeof(playersData) == "table" then
                for pName, pInfo in pairs(playersData) do
                    if typeof(pInfo) == "table" then
                        local sName = tostring(pName)
                        if pInfo.Role ~= nil then PlayerRolesCache[sName] = tostring(pInfo.Role) end
                        if pInfo.Dead ~= nil then PlayerAliveCache[sName] = (pInfo.Dead == true) end
                    end
                end
            end
        end))
    end

    local roundEnd = FindRemoteEvent("RoundEndFade")
    if roundEnd then
        RegisterConnection(roundEnd.OnClientEvent:Connect(function()
            if IsTerminated then return end
            if CurrentState == State.Action then
                ChangeState(State.WaitingForRoundEnd)
            end
        end))
    end

    local playerDataChanged = FindRemoteEvent("PlayerDataChanged")
    if playerDataChanged then
        RegisterConnection(playerDataChanged.OnClientEvent:Connect(function(data)
            if IsTerminated or typeof(data) ~= "table" then return end
            local count = 0
            for pName, pInfo in pairs(data) do
                count = count + 1
                if typeof(pInfo) == "table" then
                    local sName = tostring(pName)
                    if pInfo.Dead ~= nil then PlayerAliveCache[sName] = (pInfo.Dead == true) end
                    if pInfo.Role ~= nil then PlayerRolesCache[sName] = tostring(pInfo.Role) end
                end
            end
            if count == 0 and CurrentState ~= State.Action then
                table.clear(PlayerAliveCache)
                table.clear(PlayerRolesCache)
            end
        end))
    end

    RegisterConnection(Players.PlayerRemoving:Connect(function(plr)
        PlayerAliveCache[plr.Name] = nil
        PlayerRolesCache[plr.Name] = nil
    end))
end
SetupRemoteHooks()

