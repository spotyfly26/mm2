end

local function IsPlayerActuallyAlive(plr: Player): boolean
    local char = plr.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end

    -- Строгая серверная проверка через PlayerAliveCache (синхронизируется через RoundStart / PlayerDataChanged):
    -- nil   -> Не участвует в раунде (зритель / только зашёл на сервер)
    -- true  -> Мёртв (Dead = true)
    -- false -> Полноценно жив в раунде (Dead = false)
    return PlayerAliveCache[plr.Name] == false
end

local function AutoFarmCleanUp()
    table.clear(rt.touchedCoins)
    table.clear(rt.cachedCoins)
    if rt.Added then
        rt.Added:Disconnect()
        rt.Added = nil
    end
    if rt.coinRemovedConn then
        rt.coinRemovedConn:Disconnect()
        rt.coinRemovedConn = nil
    end
    if rt.ancestryConn then
        rt.ancestryConn:Disconnect()
        rt.ancestryConn = nil
    end
    rt.coinContainer = nil

    -- Безопасная swap-and-pop очистка отключенных соединений из массива ActiveConnections (O(1) на удаление)
    local connIdx = 1
    while connIdx <= #ActiveConnections do
        local conn = ActiveConnections[connIdx]
        if not conn or not conn.Connected then
            ActiveConnections[connIdx] = ActiveConnections[#ActiveConnections]
            ActiveConnections[#ActiveConnections] = nil
        else
            connIdx = connIdx + 1
        end
    end
end

