local CurrentMapInstance: Instance? = nil
local CurrentMapSpawnPosition: Vector3? = nil
local candidateConnections: { [Instance]: { RBXScriptConnection } } = {}

local function DisconnectCandidate(child: Instance)
    local conns = candidateConnections[child]
    if conns then
        for _, c in ipairs(conns) do
            if c and c.Connected then pcall(function() c:Disconnect() end) end
        end
        candidateConnections[child] = nil
    end
end

local function IsMapCandidate(child: Instance): boolean
    if not child:IsA("Model") and not child:IsA("Folder") then return false end
    if child == LocalPlayer.Character or (child:IsA("Model") and Players:GetPlayerFromCharacter(child)) then return false end
    if child.Name == "Lobby" or child.Name == "Terrain" or child.Name == "Camera" then return false end
    if child.Name == "RaycastFilter" or child.Name == "GunDrop" then return false end
    return true
end

local function CleanupMap(child: Instance)
    DisconnectCandidate(child)
    if CurrentMapInstance == child then
        CurrentMapInstance = nil
        CurrentMapSpawnPosition = nil
        rt.coinContainer = nil
        AutoFarmCleanUp()
    end
end

local function GetMapSpawnPosition(): Vector3?
    if CurrentMapSpawnPosition then return CurrentMapSpawnPosition end
    if not CurrentMapInstance or CurrentMapInstance.Parent ~= Workspace then return nil end
    local spawns = CurrentMapInstance:FindFirstChild("Spawns")
    if spawns then
        local p = spawns:FindFirstChildWhichIsA("BasePart", true)
        if p then
            CurrentMapSpawnPosition = p.Position
            return p.Position
        end
    end
    if CurrentMapInstance:IsA("Model") then
        local ok, cf = pcall(function() return (CurrentMapInstance :: Model):GetPivot() end)
        if ok and cf then
            CurrentMapSpawnPosition = cf.Position
            return cf.Position
        end
    end
    return nil
end

local function RegisterMap(child: Instance, spawns: Instance?, container: Instance?)
    if CurrentMapInstance == child then return end
    CurrentMapInstance = child
    DisconnectCandidate(child)

    CurrentMapSpawnPosition = nil
    local s = spawns or child:FindFirstChild("Spawns")
    if s then
        local p = s:FindFirstChildWhichIsA("BasePart", true)
        if p then CurrentMapSpawnPosition = p.Position end
    end
    if not CurrentMapSpawnPosition and child:IsA("Model") then
        local ok, cf = pcall(function() return child:GetPivot() end)
        if ok and cf then CurrentMapSpawnPosition = cf.Position end
    end

    if container then
        rt.coinContainer = container
        if CurrentState == State.Action and SETTINGS.AutoFarmEnabled then
            PopulateCoins()
        end
    else
        local ccConn: RBXScriptConnection? = nil
        ccConn = child.ChildAdded:Connect(function(newChild)
            if newChild.Name == "CoinContainer" then
                if ccConn then ccConn:Disconnect(); ccConn = nil end
                rt.coinContainer = newChild
                if CurrentState == State.Action and SETTINGS.AutoFarmEnabled then
                    PopulateCoins()
                end
            end
        end)
        if ccConn then RegisterConnection(ccConn) end

        task.spawn(function()
            local cc = child:WaitForChild("CoinContainer", 15)
            if cc and not rt.coinContainer and CurrentMapInstance == child then
                rt.coinContainer = cc
                if CurrentState == State.Action and SETTINGS.AutoFarmEnabled then
                    PopulateCoins()
                end
            end
        end)
    end

    local remConn = child.AncestryChanged:Connect(function(_, parent)
        if not parent or parent ~= Workspace then
            CleanupMap(child)
        end
    end)
    RegisterConnection(remConn)
end

local function InspectMapCandidate(child: Instance)
    if not IsMapCandidate(child) then return end
    if CurrentMapInstance == child then return end

    local container = child:FindFirstChild("CoinContainer")
    local spawns = child:FindFirstChild("Spawns")

    if container or spawns then
        DisconnectCandidate(child)
        RegisterMap(child, spawns, container)
        return
    end

    if not candidateConnections[child] then
        candidateConnections[child] = {}

        local addConn = child.ChildAdded:Connect(function(newChild)
            if newChild.Name == "Spawns" or newChild.Name == "CoinContainer" then
                DisconnectCandidate(child)
                if not IsTerminated and child.Parent == Workspace and CurrentMapInstance ~= child then
                    local s = (newChild.Name == "Spawns") and newChild or child:FindFirstChild("Spawns")
                    local c = (newChild.Name == "CoinContainer") and newChild or child:FindFirstChild("CoinContainer")
                    RegisterMap(child, s, c)
                end
            end
        end)
        table.insert(candidateConnections[child], addConn)

        local ancConn = child.AncestryChanged:Connect(function(_, parent)
            if not parent or parent ~= Workspace then
                DisconnectCandidate(child)
            end
        end)
        table.insert(candidateConnections[child], ancConn)

        task.spawn(function()
            local foundSpawns = child:WaitForChild("Spawns", 15)
            local foundContainer = child:FindFirstChild("CoinContainer")
            if not IsTerminated and child.Parent == Workspace and (foundSpawns or foundContainer) then
                DisconnectCandidate(child)
                if CurrentMapInstance ~= child then
                    RegisterMap(child, foundSpawns, foundContainer)
                end
            end
        end)
    end
end

local function DoForceCheckMap()
    if CurrentMapInstance and CurrentMapInstance.Parent == Workspace then return end
    for _, ch in ipairs(Workspace:GetChildren()) do
        if IsMapCandidate(ch) and CurrentMapInstance ~= ch then
            InspectMapCandidate(ch)
            if CurrentMapInstance then break end
            if not CurrentMapInstance and ch:IsA("Model") and #ch:GetChildren() > 5 then
                RegisterMap(ch, ch:FindFirstChild("Spawns"), ch:FindFirstChild("CoinContainer"))
                break
            end
        end
    end
end

for _, ch in ipairs(Workspace:GetChildren()) do
    InspectMapCandidate(ch)
end

RegisterConnection(Workspace.ChildAdded:Connect(function(child)
    if IsTerminated then return end
    task.defer(function()
        InspectMapCandidate(child)
    end)
end))

RegisterConnection(Workspace.ChildRemoved:Connect(function(child)
    CleanupMap(child)
end))

