-- Форматирование текста статистики
local function getStatsDisplayText(): string
    local timeElapsed = (StatsData.StartTime > 0) and (tick() - StatsData.StartTime) or 0
    local h = math.floor(timeElapsed / 3600)
    local m = math.floor((timeElapsed % 3600) / 60)
    local s = math.floor(timeElapsed % 60)
    local hoursFloat = timeElapsed / 3600
    local perHour = (hoursFloat > 0) and math.floor(StatsData.CoinsCollected / hoursFloat) or 0

    local bagInfo = (CurrentState == State.Action and ActiveCurrencyName ~= "—")
        and string.format("%s: %d", ActiveCurrencyName, BagCoinCount)
        or "—"

    return string.format("Время: %02d:%02d:%02d | В сумке: %s\nВ инвентаре: %s\nМонет собрано: %d\nМонет в час: %d",
        h, m, s, bagInfo, TotalInventoryTokens, StatsData.CoinsCollected, perHour)
end

