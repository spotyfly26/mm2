local PROFILE_FILE = "profile"

local function LoadProfile(): { [string]: any }?
    local rf = readfile or (syn and syn.readfile)
    local isf = isfile or (syn and syn.isfile)
    if typeof(isf) == "function" and typeof(rf) == "function" then
        local targetFile = nil
        local ok1, exists1 = pcall(isf, PROFILE_FILE)
        if ok1 and exists1 then
            targetFile = PROFILE_FILE
        else
            local ok2, exists2 = pcall(isf, PROFILE_FILE .. ".json")
            if ok2 and exists2 then
                targetFile = PROFILE_FILE .. ".json"
            end
        end

        if targetFile then
            local readOk, content = pcall(rf, targetFile)
            if readOk and typeof(content) == "string" and content ~= "" then
                local decodeOk, data = pcall(function()
                    return HttpService:JSONDecode(content)
                end)
                if decodeOk and typeof(data) == "table" then
                    return data
                end
            end
        end
    end
    return nil
end

