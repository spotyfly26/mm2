-- Цикл обратного отсчета таймера и безопасного перезахода
task.spawn(function()
    while not IsTerminated do
        task.wait(1)
        if not SETTINGS.AutoRejoinEnabled then
            RejoinStartTime = tick()
            RejoinPending = false
            if RejoinCountdownLabel then
                RejoinCountdownLabel.Text = "Статус: ВЫКЛЮЧЕН"
                RejoinCountdownLabel.TextColor3 = Color3.fromRGB(180, 180, 190)
            end
            continue
        end

        local elapsed = tick() - RejoinStartTime
        local remaining = math.max(0, math.floor(SETTINGS.RejoinTime - elapsed))
        
        local h = math.floor(remaining / 3600)
        local m = math.floor((remaining % 3600) / 60)
        local s = math.floor(remaining % 60)

        if RejoinCountdownLabel then
            if RejoinPending then
                RejoinCountdownLabel.Text = "Ожидание лобби для перезахода..."
                RejoinCountdownLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
            else
                RejoinCountdownLabel.Text = string.format("До перезахода: %02d:%02d:%02d", h, m, s)
                RejoinCountdownLabel.TextColor3 = Color3.fromRGB(150, 220, 255)
            end
        end

        if remaining <= 0 and not isTeleporting then
            RejoinPending = true
            local canSafelyRejoin = (CurrentState == State.WaitingForRound) or (not rt:CheckIfGameInProgress())
            if canSafelyRejoin then
                DoRejoin("Плановый таймер")
            end
        end
    end
end)

-- === POTATO MODE ===
local EffectsToDestroy = {
    ["Decal"] = true, ["Texture"] = true, ["PostEffect"] = true,
    ["Sky"] = true, ["Atmosphere"] = true, ["SunRaysEffect"] = true,
    ["BloomEffect"] = true, ["BlurEffect"] = true, ["ColorCorrectionEffect"] = true,
    ["DepthOfFieldEffect"] = true, ["ParticleEmitter"] = true, ["Trail"] = true,
    ["Fire"] = true, ["Smoke"] = true, ["Sparkles"] = true
}

local RenderingDisabled = false

local function makePartPotato(v)
    if v:IsA("BasePart") then
        if not RenderingDisabled then
            v.Material = Enum.Material.SmoothPlastic
            v.Reflectance = 0
            v.CastShadow = false
            if v:IsA("MeshPart") then
                v.TextureID = ""
            end
        end
    elseif EffectsToDestroy[v.ClassName] then
        v:Destroy()
    end
end

local function applyPotatoMode()
    if SETTINGS.PotatoMode then
        local supported = setTargetFps(SETTINGS.FpsCap)
        if not supported then
            UpdateStatus("FPS Cap: не поддерживается инжектором", Color3.fromRGB(255, 120, 120))
        end
        pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false) end)
        pcall(function() RunService:Set3dRenderingEnabled(false) end)
        RenderingDisabled = true

        Lighting.GlobalShadows = false
        Lighting.FogEnd = 9e9
        Lighting.Brightness = 1
        pcall(function() sethiddenproperty(Lighting, "Technology", 2) end)

        task.spawn(function()
            for _, v in ipairs(Lighting:GetDescendants()) do makePartPotato(v) end
            for _, v in ipairs(Workspace:GetDescendants()) do
                makePartPotato(v)
                if not SETTINGS.PotatoMode or IsTerminated then break end
            end
        end)

        if #rt.potatoConnections == 0 then
            table.insert(rt.potatoConnections, Workspace.ChildAdded:Connect(function(child)
                if not SETTINGS.PotatoMode or IsTerminated then return end

                -- Мелкие детали и графические эффекты обрабатываем мгновенно без создания потока
                if child:IsA("BasePart") or EffectsToDestroy[child.ClassName] then
                    makePartPotato(child)
                    return
                end

                -- Для моделей и папок: отложенный обход с защитой от обработки персонажей
                if child:IsA("Model") or child:IsA("Folder") then
                    task.spawn(function()
                        if Players:GetPlayerFromCharacter(child) or child:FindFirstChildOfClass("Humanoid") then
                            return
                        end
                        task.wait(0.1)
                        if not SETTINGS.PotatoMode or IsTerminated then return end
                        if Players:GetPlayerFromCharacter(child) or child:FindFirstChildOfClass("Humanoid") then
                            return
                        end
                        makePartPotato(child)
                        for _, v in ipairs(child:GetDescendants()) do
                            makePartPotato(v)
                        end
                    end)
                end
            end))

            table.insert(rt.potatoConnections, Lighting.ChildAdded:Connect(function(child)
                if not SETTINGS.PotatoMode or IsTerminated then return end
                if child:IsA("BasePart") or EffectsToDestroy[child.ClassName] then
                    makePartPotato(child)
                    return
                end
                task.spawn(function()
                    task.wait(0.1)
                    if not SETTINGS.PotatoMode or IsTerminated then return end
                    makePartPotato(child)
                    for _, v in ipairs(child:GetDescendants()) do
                        makePartPotato(v)
                    end
                end)
            end))
        end
    else
        setTargetFps(60)
        pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, true) end)
        pcall(function() RunService:Set3dRenderingEnabled(true) end)
        RenderingDisabled = false

        for _, conn in pairs(rt.potatoConnections) do
            if conn.Connected then conn:Disconnect() end
        end
        table.clear(rt.potatoConnections)
    end
end

