            local rt = State.rt
            local AutoFarm = {}
            local twinMotionCache: {[string]: TwinMotionEntry__DARKLUA_TYPE_a} = {}
            local hasPublishedActiveSync = false

            local function HasAnyTwinInServer(): boolean
                for _, plr in ipairs(Players:GetPlayers())do
                    if plr ~= LocalPlayer and Network.IsTwinPlayer(plr, plr.Name) then
                        return true
                    end
                end

                return false
            end
            local function PublishTwinSync(
                farming: boolean,
                targetPos: Vector3?,
                nextPos: Vector3?
            )
                if farming then
                    if SETTINGS.TwinAvoidEnabled and Network.HasTwinsConfigured() and HasAnyTwinInServer() then
                        Config.WriteTwinSync(true, State.BagIsFull, targetPos, nextPos)

                        hasPublishedActiveSync = true
                    end
                elseif hasPublishedActiveSync then
                    Config.WriteTwinSync(false, State.BagIsFull, nil, nil)

                    hasPublishedActiveSync = false
                end
            end

            function AutoFarm.AutoFarmCleanUp()
                table.clear(rt.touchedCoins)
                table.clear(rt.cachedCoins)
                table.clear(rt.cachedBodyParts)
                table.clear(twinMotionCache)
                PublishTwinSync(false, nil, nil)
                State.DisconnectCharDescConn()

                if rt.Added then
                    rt.Added:Disconnect()

                    rt.Added = nil
                end
                if rt.coinRemovedConn then
                    rt.coinRemovedConn:Disconnect()

                    rt.coinRemovedConn = nil
                end
                if rt.ancestryConn then
                    rt.ancestryConn:Disconnect()

                    rt.ancestryConn = nil
                end

                rt.coinContainer = nil

                State.PruneActiveConnections()
            end

            local function IsBagFull()
                return State.BagIsFull
            end
            local function isCoinTouched(coin: Instance)
                return rt.touchedCoins[coin] ~= nil
            end
            local function markCoinAsPending(coin: Instance)
                if not rt then
                    return
                end

                rt.touchedCoins[coin] = 'pending'
                rt.cachedCoins[coin] = nil
            end

            function AutoFarm.PopulateCoins()
                table.clear(rt.cachedCoins)

                if not rt.coinContainer then
                    return
                end
                if rt.Added then
                    rt.Added:Disconnect()

                    rt.Added = nil
                end
                if rt.coinRemovedConn then
                    rt.coinRemovedConn:Disconnect()

                    rt.coinRemovedConn = nil
                end
                if rt.ancestryConn then
                    rt.ancestryConn:Disconnect()

                    rt.ancestryConn = nil
                end

                rt.ancestryConn = rt.coinContainer.AncestryChanged:Connect(function(
                    _,
                    parent
                )
                    if not parent or not rt.coinContainer or not rt.coinContainer:IsDescendantOf(Workspace) then
                        AutoFarm.AutoFarmCleanUp()
                    end
                end)

                local function checkAndAdd(node: Instance)
                    if node:IsA('TouchTransmitter') and node.Parent and node.Parent:IsA('BasePart') then
                        rt.cachedCoins[node.Parent] = true
                    end
                end

                for _, desc in ipairs(rt.coinContainer:GetDescendants())do
                    checkAndAdd(desc)
                end

                rt.Added = rt.coinContainer.DescendantAdded:Connect(checkAndAdd)
                rt.coinRemovedConn = rt.coinContainer.ChildRemoved:Connect(function(
                    child
                )
                    rt.cachedCoins[child] = nil

                    if child:IsA('Model') then
                        for _, p in ipairs(child:GetChildren())do
                            rt.cachedCoins[p] = nil
                        end
                    end

                    local coin = child
                    local data = rt.touchedCoins[coin]

                    if not data and child:IsA('Model') then
                        local primary = child.PrimaryPart or child:FindFirstChildWhichIsA('BasePart')

                        if primary and rt.touchedCoins[primary] == 'pending' then
                            coin = primary
                            data = 'pending'
                        end
                    end
                    if data == 'pending' then
                        rt.touchedCoins[coin] = 'collected'
                    end
                end)
            end

            local function GetActiveTwinsInfo(): ({ActiveTwinData__DARKLUA_TYPE_b},boolean)
                local activeTwins: {ActiveTwinData__DARKLUA_TYPE_b} = {}
                local isOverallLeader = true

                if not SETTINGS.TwinAvoidEnabled or not Network.HasTwinsConfigured() then
                    return activeTwins, true
                end

                local myNameLower = string.lower(LocalPlayer.Name)
                local nowClock = os.clock()

                for _, plr in ipairs(Players:GetPlayers())do
                    if plr ~= LocalPlayer and Network.IsTwinPlayer(plr, plr.Name) and Network.IsPlayerActuallyAlive(plr) then
                        local tChar = plr.Character
                        local tHrp = tChar and (tChar.PrimaryPart or tChar:FindFirstChild('HumanoidRootPart') or tChar:FindFirstChildWhichIsA('BasePart'))

                        if tHrp then
                            local sync = Config.ReadTwinSync(plr.Name)

                            if sync and (sync.bagFull == true or sync.farming == false) then
                                continue
                            end

                            local tPos = tHrp.Position
                            local vel = tHrp.AssemblyLinearVelocity
                            local speed = vel and vel.Magnitude or 0
                            local mEntry = twinMotionCache[plr.Name]

                            if not mEntry then
                                mEntry = {
                                    lastDir = nil,
                                    lastSpeed = 0,
                                    lastMoveClock = nowClock,
                                    anchorPos = tPos,
                                    stationarySince = nowClock,
                                }
                                twinMotionCache[plr.Name] = mEntry
                            else
                                if (tPos - mEntry.anchorPos).Magnitude > 1.8 or speed > 2.5 then
                                    mEntry.anchorPos = tPos
                                    mEntry.stationarySince = nowClock
                                end
                                if speed > 3 then
                                    mEntry.lastDir = vel.Unit
                                    mEntry.lastSpeed = speed
                                    mEntry.lastMoveClock = nowClock
                                end
                            end
                            if not sync and (nowClock - mEntry.stationarySince) > 3.5 then
                                continue
                            end

                            local claimedTarget: Vector3? = nil
                            local nextTarget: Vector3? = nil

                            if sync then
                                if typeof(sync.tx) == 'number' and typeof(sync.ty) == 'number' and typeof(sync.tz) == 'number' then
                                    claimedTarget = Vector3.new(sync.tx, sync.ty, sync.tz)
                                end
                                if typeof(sync.nx) == 'number' and typeof(sync.ny) == 'number' and typeof(sync.nz) == 'number' then
                                    nextTarget = Vector3.new(sync.nx, sync.ny, sync.nz)
                                end
                            end

                            local predPos: Vector3? = nil

                            if speed > 3 then
                                predPos = tPos + (vel.Unit * math.min(speed * 1.8, 50))
                            elseif mEntry.lastDir and (nowClock - mEntry.lastMoveClock) < 0.45 then
                                predPos = tPos + (mEntry.lastDir * math.min(mEntry.lastSpeed * 1.3, 38))
                            elseif claimedTarget then
                                predPos = claimedTarget
                            end

                            local twinNameLower = string.lower(plr.Name)
                            local meLeaderOverThis = (myNameLower < twinNameLower)

                            if not meLeaderOverThis then
                                isOverallLeader = false
                            end

                            table.insert(activeTwins, {
                                plr = plr,
                                pos = tPos,
                                predPos = predPos,
                                claimedTarget = claimedTarget,
                                nextTarget = nextTarget,
                                anchorPos = claimedTarget or tPos,
                                isMeLeaderOverTwin = meLeaderOverThis,
                            })
                        end
                    end
                end

                return activeTwins, isOverallLeader
            end

            function AutoFarm.GetNearestCoin(isFirstCoin: boolean?): (Instance?,Vector3?)
                local char = rt:Character()

                if not char or not char.PrimaryPart then
                    return nil, nil
                end

                local myPos = char.PrimaryPart.Position
                local activeTwins, isOverallLeader = GetActiveTwinsInfo()
                local hasActiveTwins = (#activeTwins > 0)
                local bestCoin: Instance? = nil
                local bestScore = (isFirstCoin and hasActiveTwins and not isOverallLeader) and 
-math.huge or math.huge
                local secondBestPos: Vector3? = nil
                local secondBestDist = math.huge
                local fallbackCoin: Instance? = nil
                local fallbackDist = math.huge
                local claimedFallbackCoin: Instance? = nil
                local claimedFallbackDist = math.huge
                local avoidRadius = SETTINGS.TwinAvoidRadius or 30

                for coin, _ in pairs(rt.cachedCoins)do
                    if coin and coin.Parent and not isCoinTouched(coin) and coin:FindFirstChildWhichIsA('TouchTransmitter') then
                        local coinPos = (coin::BasePart).Position
                        local myDist = (coinPos - myPos).Magnitude
                        local isHardClaimedByTwin = false

                        if hasActiveTwins then
                            for _, twin in ipairs(activeTwins)do
                                if twin.claimedTarget and (coinPos - twin.claimedTarget).Magnitude < 4.5 then
                                    local twinDistToClaim = (coinPos - twin.pos).Magnitude

                                    if not (myDist + 4 < twinDistToClaim and twin.isMeLeaderOverTwin) then
                                        isHardClaimedByTwin = true

                                        break
                                    end
                                end
                            end
                        end
                        if isHardClaimedByTwin then
                            if myDist < claimedFallbackDist then
                                claimedFallbackDist = myDist
                                claimedFallbackCoin = coin
                            end

                            continue
                        end
                        if myDist < fallbackDist then
                            fallbackDist = myDist
                            fallbackCoin = coin
                        end
                        if isFirstCoin and hasActiveTwins and not isOverallLeader then
                            local minTwinAnchorDist = math.huge

                            for _, twin in ipairs(activeTwins)do
                                local d = (coinPos - twin.anchorPos).Magnitude

                                if d < minTwinAnchorDist then
                                    minTwinAnchorDist = d
                                end
                            end

                            local startScore = minTwinAnchorDist - (myDist * 0.2)

                            if startScore > bestScore then
                                bestScore = startScore
                                bestCoin = coin
                            end

                            continue
                        end

                        local isTwinZone = false

                        if hasActiveTwins then
                            for _, twin in ipairs(activeTwins)do
                                if twin.claimedTarget and (coinPos - twin.claimedTarget).Magnitude < 14 then
                                    isTwinZone = true

                                    break
                                end
                                if twin.nextTarget and (coinPos - twin.nextTarget).Magnitude < 10 then
                                    isTwinZone = true

                                    break
                                end

                                local botsDist = (myPos - twin.pos).Magnitude
                                local minSafeDist = (botsDist < 25) and 4 or 12

                                if myDist > minSafeDist then
                                    local twinDist = (coinPos - twin.pos).Magnitude
                                    local predDist = twin.predPos and (coinPos - twin.predPos).Magnitude or math.huge

                                    if (twinDist < avoidRadius) or (predDist < 18) or (twinDist < myDist) or (twinDist == myDist and not twin.isMeLeaderOverTwin) then
                                        isTwinZone = true

                                        break
                                    end
                                end
                            end
                        end
                        if not isTwinZone then
                            if myDist < bestScore then
                                if bestCoin then
                                    secondBestDist = bestScore
                                    secondBestPos = (bestCoin::BasePart).Position
                                end

                                bestScore = myDist
                                bestCoin = coin
                            elseif myDist < secondBestDist then
                                secondBestDist = myDist
                                secondBestPos = coinPos
                            end
                        end
                    else
                        rt.cachedCoins[coin] = nil
                    end
                end

                local chosen = bestCoin or fallbackCoin or claimedFallbackCoin

                return chosen, secondBestPos
            end

            local function moveToPositionPhysically(
                targetPosition: Vector3,
                targetCoin: Instance,
                bv: BodyVelocity,
                bg: BodyGyro
            ): (boolean,boolean)
                local char = rt:Character()

                if not char or not char.PrimaryPart then
                    return false, false
                end

                local hrp = char.PrimaryPart
                local underfloorOffset = SETTINGS.UnderfloorOffset or 3.8
                local finalPosition = targetPosition - Vector3.new(0, underfloorOffset, 0)
                local startPos = hrp.Position
                local lookAtPos = Vector3.new(finalPosition.X, startPos.Y, finalPosition.Z)

                if (lookAtPos - startPos).Magnitude > 0.1 then
                    bg.CFrame = CFrame.new(startPos, lookAtPos) * CFrame.Angles(math.rad(
-90), 0, 0)
                end

                local coinRemoved = false
                local cRemoved: RBXScriptConnection? = nil

                if targetCoin and targetCoin.Parent then
                    cRemoved = targetCoin.ChildRemoved:Connect(function(child)
                        if child:IsA('TouchTransmitter') or child.Name == 'TouchInterest' then
                            coinRemoved = true
                        end
                    end)
                end

                local flyStart = os.clock()
                local lastHijackCheck = 0

                while not State.IsTerminated and SETTINGS.AutoFarmEnabled and char and char.PrimaryPart and State.CurrentState == State.Action do
                    local now = os.clock()

                    if now - flyStart > 6 then
                        break
                    end

                    local hum = char:FindFirstChildOfClass('Humanoid')

                    if hum and hum.Health <= 0 then
                        break
                    end
                    if coinRemoved or rt.touchedCoins[targetCoin] == 'collected' then
                        if cRemoved then
                            cRemoved:Disconnect()
                        end

                        rt.touchedCoins[targetCoin] = 'collected'
                        rt.cachedCoins[targetCoin] = nil

                        return true, false
                    end

                    local currentPos = hrp.Position
                    local distance = (finalPosition - currentPos).Magnitude

                    if distance > 5 and (now - lastHijackCheck) >= 0.15 then
                        lastHijackCheck = now

                        local activeTwins = GetActiveTwinsInfo()

                        for _, twin in ipairs(activeTwins)do
                            local twinDistToTarget = (targetPosition - twin.pos).Magnitude
                            local twinClaimedThis = (twin.claimedTarget ~= nil and (targetPosition - twin.claimedTarget).Magnitude < 4.5)

                            if (twinDistToTarget < 6.5 and distance > 12) or (twinClaimedThis and (twinDistToTarget + 2 < distance or (math.abs(twinDistToTarget - distance) <= 2 and not twin.isMeLeaderOverTwin))) then
                                if cRemoved then
                                    cRemoved:Disconnect()
                                end

                                return false, true
                            end
                        end
                    end
                    if distance < 2 then
                        local touchFn = firetouchtransmitter or firetouchinterest or (syn and syn.firetouchinterest)
                        local touchPart = char:FindFirstChild('Head') or hrp

                        if touchFn and targetCoin and targetCoin.Parent then
                            pcall(function()
                                touchFn(touchPart, targetCoin, 0)
                                touchFn(touchPart, targetCoin, 1)

                                if touchPart ~= hrp then
                                    touchFn(hrp, targetCoin, 0)
                                    touchFn(hrp, targetCoin, 1)
                                end
                            end)
                        end

                        local waitStart = os.clock()

                        while not coinRemoved and rt.touchedCoins[targetCoin] ~= 'collected' and (os.clock() - waitStart < 0.25) and not State.IsTerminated and SETTINGS.AutoFarmEnabled do
                            RunService.Heartbeat:Wait()
                        end

                        if cRemoved then
                            cRemoved:Disconnect()
                        end

                        rt.touchedCoins[targetCoin] = 'collected'
                        rt.cachedCoins[targetCoin] = nil

                        return true, false
                    end

                    local direction = (finalPosition - currentPos).Unit

                    bv.Velocity = direction * SETTINGS.Speed

                    RunService.Heartbeat:Wait()
                end

                if cRemoved then
                    cRemoved:Disconnect()
                end

                return false, false
            end
            local function CollectCoins()
                State.BagIsFull = false

                local map = MapTracker.Map()

                if map then
                    if not rt.coinContainer then
                        rt.coinContainer = map:FindFirstChild('CoinContainer')
                    end
                    if rt.coinContainer then
                        AutoFarm.PopulateCoins()
                    end
                end

                local char = rt:Character()
                local hrp = char and (char.PrimaryPart or char:FindFirstChild('HumanoidRootPart')::BasePart?)
                local hum = char and char:FindFirstChildOfClass('Humanoid')

                if not char or not hrp then
                    return
                end
                if not char.PrimaryPart then
                    pcall(function()
                        char.PrimaryPart = hrp
                    end)
                end

                State.UpdateBodyPartsCache()

                if hum then
                    hum.PlatformStand = true
                end

                local bv = hrp:FindFirstChild('FarmVelocity') or Instance.new('BodyVelocity')

                bv.Name = 'FarmVelocity'
                bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                bv.Velocity = Vector3.zero
                bv.Parent = hrp

                local bg = hrp:FindFirstChild('FarmGyro') or Instance.new('BodyGyro')

                bg.Name = 'FarmGyro'
                bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
                bg.P = 3000
                bg.Parent = hrp

                local isFirstCoin = true
                local coinRetries: {[Instance]: number} = {}

                while not State.IsTerminated and State.CurrentState == State.Action and SETTINGS.AutoFarmEnabled and not State.BagIsFull and Network.CheckIfPlayerWasInARound() do
                    char = rt:Character()

                    if not char or not char.PrimaryPart then
                        break
                    end

                    hrp = char.PrimaryPart

                    local targetCoin, nextCoinPos = AutoFarm.GetNearestCoin(isFirstCoin)

                    if targetCoin then
                        local targetBasePart = targetCoin::BasePart

                        PublishTwinSync(true, targetBasePart.Position, nextCoinPos)

                        if isFirstCoin then
                            isFirstCoin = false

                            State.UpdateStatus('\u{424}\u{430}\u{440}\u{43c}: \u{422}\u{41f} (8 \u{441}\u{442}\u{443}\u{434}\u{43e}\u{432} \u{43e}\u{442} \u{43f}\u{435}\u{440}\u{432}\u{43e}\u{439} \u{43c}\u{43e}\u{43d}\u{435}\u{442}\u{44b})', Color3.fromRGB(120, 255, 120))

                            local underfloorOffset = SETTINGS.UnderfloorOffset or 3.8
                            local targetPos = targetBasePart.Position - Vector3.new(0, underfloorOffset, 0)
                            local currentPos = hrp.Position
                            local diff = currentPos - targetPos
                            local diffXZ = Vector3.new(diff.X, 0, diff.Z)
                            local dirXZ = (diffXZ.Magnitude > 0.1) and diffXZ.Unit or Vector3.new(0, 0, 1)
                            local tpPos = targetPos + (dirXZ * 8)
                            local lookAtPos = Vector3.new(targetPos.X, tpPos.Y, targetPos.Z)
                            local tpCFrame = CFrame.new(tpPos, lookAtPos) * CFrame.Angles(math.rad(
-90), 0, 0)

                            for _, part in ipairs(rt.cachedBodyParts)do
                                if part and part.Parent then
                                    part.CanCollide = false
                                end
                            end

                            hrp.AssemblyLinearVelocity = Vector3.zero
                            hrp.AssemblyAngularVelocity = Vector3.zero

                            char:PivotTo(tpCFrame)

                            bg.CFrame = tpCFrame
                            bv.Velocity = Vector3.zero

                            RunService.Heartbeat:Wait()
                        end

                        State.UpdateStatus('\u{424}\u{430}\u{440}\u{43c}: \u{41b}\u{435}\u{447}\u{443} \u{43a} \u{43c}\u{43e}\u{43d}\u{435}\u{442}\u{435}', Color3.fromRGB(150, 255, 150))
                        markCoinAsPending(targetCoin)

                        local pickedUp, wasHijacked = moveToPositionPhysically(targetBasePart.Position, targetCoin, bv, bg)

                        if not SETTINGS.AutoFarmEnabled or State.IsTerminated then
                            break
                        end
                        if pickedUp and rt.touchedCoins[targetCoin] == 'pending' then
                            rt.touchedCoins[targetCoin] = 'collected'

                            if IsBagFull() then
                                break
                            end
                        elseif wasHijacked and rt.touchedCoins[targetCoin] == 'pending' then
                            if targetCoin.Parent and targetCoin:FindFirstChildWhichIsA('TouchTransmitter') then
                                rt.touchedCoins[targetCoin] = nil
                                rt.cachedCoins[targetCoin] = true
                            end
                        elseif not pickedUp and rt.touchedCoins[targetCoin] == 'pending' and targetCoin.Parent and targetCoin:FindFirstChildWhichIsA('TouchTransmitter') then
                            local tries = (coinRetries[targetCoin] or 0) + 1

                            coinRetries[targetCoin] = tries

                            if tries <= 1 then
                                rt.touchedCoins[targetCoin] = nil
                                rt.cachedCoins[targetCoin] = true
                            end
                        end
                    else
                        PublishTwinSync(false, nil, nil)

                        if not rt.coinContainer then
                            local currentMap = MapTracker.Map()

                            if currentMap then
                                local foundCc = currentMap:FindFirstChild('CoinContainer')

                                if foundCc then
                                    rt.coinContainer = foundCc

                                    AutoFarm.PopulateCoins()
                                end
                            end
                        elseif next(rt.cachedCoins) == nil then
                            AutoFarm.PopulateCoins()
                        end

                        State.UpdateStatus('\u{424}\u{430}\u{440}\u{43c}: \u{421}\u{435}\u{439}\u{444}-\u{437}\u{43e}\u{43d}\u{430} (\u{43e}\u{436}\u{438}\u{434}\u{430}\u{43d}\u{438}\u{435} \u{43f}\u{43e}\u{44f}\u{432}\u{43b}\u{435}\u{43d}\u{438}\u{44f} \u{43c}\u{43e}\u{43d}\u{435}\u{442})...', Color3.fromRGB(130, 200, 255))

                        bv.Velocity = Vector3.zero

                        task.wait(0.1)
                    end
                end

                PublishTwinSync(false, nil, nil)

                if bv and bv.Parent then
                    bv:Destroy()
                end
                if bg and bg.Parent then
                    bg:Destroy()
                end
                if hrp then
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                end
                if hum then
                    hum.PlatformStand = false
                end

                AutoFarm.AutoFarmCleanUp()
            end
            local function ActionState()
                if (SETTINGS.RoundMode == 'Assassin' or SETTINGS.RoundMode == 'Clear') and SETTINGS.AutoFarmEnabled and not State.IsTerminated and Network.RoundInProgress() and Network.CheckIfPlayerWasInARound() then
                    task.spawn(function()
                        Combat.PreRoundKillChain()
                    end)
                end
                if not SETTINGS.AutoFarmEnabled or State.IsTerminated then
                    return
                end
                if Network.RoundInProgress() and Network.CheckIfPlayerWasInARound() then
                    CollectCoins()
                end
                if not SETTINGS.AutoFarmEnabled or State.IsTerminated then
                    return
                end

                local function maintainHoverUntilRoundEnd()
                    local char = rt:Character()
                    local hrp = char and (char.PrimaryPart or char:FindFirstChild('HumanoidRootPart')::BasePart?)
                    local hum = char and char:FindFirstChildOfClass('Humanoid')

                    if not hrp or not hum then
                        return
                    end

                    hum.PlatformStand = true

                    local hoverV = hrp:FindFirstChild('FarmVelocity') or Instance.new('BodyVelocity')

                    hoverV.Name = 'FarmVelocity'
                    hoverV.Velocity = Vector3.zero
                    hoverV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                    hoverV.Parent = hrp

                    local hoverG = hrp:FindFirstChild('FarmGyro') or Instance.new('BodyGyro')

                    hoverG.Name = 'FarmGyro'
                    hoverG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
                    hoverG.CFrame = hrp.CFrame
                    hoverG.P = 3000
                    hoverG.Parent = hrp
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero

                    while not State.IsTerminated and Network.RoundInProgress() and SETTINGS.AutoFarmEnabled and hum.Health > 0 do
                        hum.PlatformStand = true
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        hrp.AssemblyAngularVelocity = Vector3.zero

                        task.wait(0.2)
                    end

                    if hoverV and hoverV.Parent then
                        hoverV:Destroy()
                    end
                    if hoverG and hoverG.Parent then
                        hoverG:Destroy()
                    end
                    if hum then
                        hum.PlatformStand = false
                    end
                end

                if State.BagIsFull then
                    if SETTINGS.BagFullMode == 'KillAll' then
                        Combat.KillFinalTarget()
                        task.wait(0.3)

                        State.BagIsFull = false

                        State.ChangeState(State.WaitingForRoundEnd)
                        maintainHoverUntilRoundEnd()
                    elseif SETTINGS.BagFullMode == 'AFK' then
                        Combat.UnequipKnife()
                        State.UpdateStatus('\u{421}\u{443}\u{43c}\u{43a}\u{430} \u{43f}\u{43e}\u{43b}\u{43d}\u{430}: AFK (\u{43f}\u{430}\u{440}\u{435}\u{43d}\u{438}\u{435} \u{43d}\u{430} \u{43c}\u{435}\u{441}\u{442}\u{435})', Color3.fromRGB(170, 130, 255))

                        State.BagIsFull = false

                        State.ChangeState(State.WaitingForRoundEnd)
                        maintainHoverUntilRoundEnd()
                    else
                        State.UpdateStatus('\u{421}\u{443}\u{43c}\u{43a}\u{430} \u{43f}\u{43e}\u{43b}\u{43d}\u{430}: \u{421}\u{431}\u{440}\u{43e}\u{441} \u{43f}\u{435}\u{440}\u{441}\u{43e}\u{43d}\u{430}\u{436}\u{430}', Color3.fromRGB(200, 200, 200))
                        State.ChangeState(State.WaitingForRoundEnd)

                        local char = rt:Character()

                        if char then
                            local hum = char:FindFirstChild('Humanoid')::Humanoid?

                            if hum then
                                hum.Health = 0

                                hum:ChangeState(Enum.HumanoidStateType.Dead)
                            end

                            pcall(function()
                                char:BreakJoints()
                            end)
                        end
                    end
                elseif not Network.RoundInProgress() then
                    State.ChangeState(State.WaitingForRound)
                else
                    State.ChangeState(State.WaitingForRoundEnd)
                end
            end
            local function WaitingForRound()
                State.BagIsFull = false

