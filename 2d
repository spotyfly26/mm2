-- === ЛОГИКА СКАНИРОВАНИЯ ===
local function GetRelativePath(obj)
    local path = obj.Name
    local curr = obj.Parent
    while curr and curr.Name ~= "PlayerGui" and curr.Name ~= "CoreGui" and curr ~= game do
        path = curr.Name .. "." .. path
        curr = curr.Parent
    end
    return path
end

-- Проверка реальной видимости элемента по цепочке предков и свойствам прозрачности
local function CheckVisibilityHierarchy(obj: GuiObject): (boolean, string)
    if not obj.Visible then
        return false, "obj.Visible = false"
    end

    if obj.AbsoluteSize.X <= 0 or obj.AbsoluteSize.Y <= 0 then
        return false, string.format("Размер 0x0 (%dx%d)", math.floor(obj.AbsoluteSize.X), math.floor(obj.AbsoluteSize.Y))
    end

    local transInfo = {}
    if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
        local tTrans = obj.TextTransparency
        if tTrans >= 1 then
            return false, string.format("TextTransparency = %.2f (100%% скрыт)", tTrans)
        end
        table.insert(transInfo, string.format("TextTrans=%.2f", tTrans))
    elseif obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
        local iTrans = obj.ImageTransparency
        if iTrans >= 1 then
            return false, string.format("ImageTransparency = %.2f (100%% скрыт)", iTrans)
        end
        table.insert(transInfo, string.format("ImgTrans=%.2f", iTrans))
    end

    -- Проверка родителей вплоть до ScreenGui / CoreGui / PlayerGui
    local curr = obj.Parent
    while curr and curr:IsA("GuiObject") do
        if not (curr :: GuiObject).Visible then
            return false, string.format("Родитель '%s'.Visible = false", curr.Name)
        end
        if curr:IsA("CanvasGroup") then
            local gTrans = (curr :: CanvasGroup).GroupTransparency
            if gTrans >= 1 then
                return false, string.format("Родитель CanvasGroup '%s'.GroupTransparency = %.2f (скрыт)", curr.Name, gTrans)
            elseif gTrans > 0 then
                table.insert(transInfo, string.format("%s.GroupTrans=%.2f", curr.Name, gTrans))
            end
        end
        curr = curr.Parent
    end

    local detailStr = #transInfo > 0 and table.concat(transInfo, ", ") or "Видимость: OK"
    return true, detailStr
end

ScanBtn.MouseButton1Click:Connect(function()
    scanStringBuffer = ""
    AddLog("--- СКАНИРОВАНИЕ 2D ИНТЕРФЕЙСА ---", Color3.fromRGB(255, 200, 50))

    if not SelectionBox or not SelectionBox.Parent then
        AddLog("Ошибка: Рамка выделения не найдена! Нажмите 'ПЕРЕСОЗДАТЬ ПОЛЗУНКИ'.", Color3.fromRGB(255, 50, 50))
        return
    end

    local minX = SelectionBox.AbsolutePosition.X
    local minY = SelectionBox.AbsolutePosition.Y
    local maxX = minX + SelectionBox.AbsoluteSize.X
    local maxY = minY + SelectionBox.AbsoluteSize.Y

    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then 
        AddLog("PlayerGui не найден!", Color3.fromRGB(255, 50, 50)) 
        return 
    end

    local foundItems = 0

    for _, obj in pairs(playerGui:GetDescendants()) do
        local isOurScanner = false
        local temp = obj
        while temp and temp ~= game do
            if temp.Name == "MM2_UI_Scanner" then isOurScanner = true break end
            temp = temp.Parent
        end
        if isOurScanner then continue end

        if obj:IsA("GuiObject") then
            if obj.AbsoluteSize.X > 0 and obj.AbsoluteSize.Y > 0 then
                local cx = obj.AbsolutePosition.X + (obj.AbsoluteSize.X / 2)
                local cy = obj.AbsolutePosition.Y + (obj.AbsoluteSize.Y / 2)

                if cx >= minX and cx <= maxX and cy >= minY and cy <= maxY then
                    local path = GetRelativePath(obj)
                    local isActuallyVisible, visReason = CheckVisibilityHierarchy(obj)

                    if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                        if obj.Text ~= "" then
                            foundItems = foundItems + 1
                            if isActuallyVisible then
                                AddLog("Текст: [" .. obj.Text .. "] (" .. obj.ClassName .. ") | ✅ ВИДИМ (" .. visReason .. ")", Color3.fromRGB(50, 255, 100))
                            else
                                AddLog("Текст: [" .. obj.Text .. "] (" .. obj.ClassName .. ") | ❌ СКРЫТ (" .. visReason .. ")", Color3.fromRGB(255, 110, 110))
                            end
                            AddLog("Путь: " .. path, Color3.fromRGB(150, 150, 150))
                        end
                    elseif obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
                        if obj.Image ~= "" then
                            foundItems = foundItems + 1
                            if isActuallyVisible then
                                AddLog("Картинка: " .. obj.ClassName .. " | ✅ ВИДИМА (" .. visReason .. ")", Color3.fromRGB(100, 200, 255))
                            else
                                AddLog("Картинка: " .. obj.ClassName .. " | ❌ СКРЫТА (" .. visReason .. ")", Color3.fromRGB(255, 110, 110))
                            end
                            AddLog("Путь: " .. path, Color3.fromRGB(150, 150, 150))
                        end
                    end
                end
            end
        end
    end

    if foundItems == 0 then
        AddLog("В рамке ничего интересного не найдено.", Color3.fromRGB(200, 100, 100))
    else
        AddLog("Найдено элементов: " .. foundItems, Color3.fromRGB(100, 255, 100))
    end
end)

