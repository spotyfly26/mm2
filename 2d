-- === РАМКА ВЫДЕЛЕНИЯ И ПОЛЗУНКИ ===
local SelectionBox = nil
local NodeA = nil
local NodeB = nil
local sliderConnections = {}

local function cleanupSliders()
    for _, conn in ipairs(sliderConnections) do
        if conn and conn.Disconnect then
            pcall(function() conn:Disconnect() end)
        end
    end
    table.clear(sliderConnections)

    if NodeA then pcall(function() NodeA:Destroy() end) NodeA = nil end
    if NodeB then pcall(function() NodeB:Destroy() end) NodeB = nil end
    if SelectionBox then pcall(function() SelectionBox:Destroy() end) SelectionBox = nil end
end

local function createDraggableNode(name, color, startX, startY)
    local node = Instance.new("Frame", ScreenGui)
    node.Name = name
    node.Size = UDim2.new(0, 40, 0, 40)
    node.Position = UDim2.new(0, startX, 0, startY)
    node.BackgroundColor3 = color
    node.ZIndex = 101
    node.Active = true
    Instance.new("UICorner", node).CornerRadius = UDim.new(1, 0)

    local label = Instance.new("TextLabel", node)
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = Color3.new(1, 1, 1)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 16

    local nDragToggle, nDragInput, nDragStart, nStartPos
    local c1 = node.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            nDragToggle = true
            nDragStart = input.Position
            nStartPos = node.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then nDragToggle = false end
            end)
        end
    end)
    local c2 = node.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then 
            nDragInput = input 
        end
    end)
    local c3 = RunService.RenderStepped:Connect(function()
        if nDragToggle and nDragInput and node and node.Parent then
            local delta = nDragInput.Position - nDragStart
            node.Position = UDim2.new(0, nStartPos.X.Offset + delta.X, 0, nStartPos.Y.Offset + delta.Y)
        end
    end)

    return node, {c1, c2, c3}
end

local function recreateSliders()
    cleanupSliders()

    SelectionBox = Instance.new("Frame", ScreenGui)
    SelectionBox.Name = "MM2_SelectionBox"
    SelectionBox.BackgroundColor3 = Color3.fromRGB(50, 150, 255)
    SelectionBox.BackgroundTransparency = 0.6
    SelectionBox.BorderSizePixel = 2
    SelectionBox.BorderColor3 = Color3.fromRGB(255, 255, 255)
    SelectionBox.ZIndex = 100

    local camera = workspace.CurrentCamera
    local vp = camera and camera.ViewportSize or Vector2.new(800, 600)
    local startAx = math.clamp(math.floor(vp.X * 0.35), 40, 1500)
    local startAy = math.clamp(math.floor(vp.Y * 0.35), 40, 1000)
    local startBx = startAx + 150
    local startBy = startAy + 150

    local nodeAObj, connsA = createDraggableNode("A", Color3.fromRGB(255, 50, 50), startAx, startAy)
    local nodeBObj, connsB = createDraggableNode("B", Color3.fromRGB(50, 50, 255), startBx, startBy)
    NodeA = nodeAObj
    NodeB = nodeBObj

    for _, c in ipairs(connsA) do table.insert(sliderConnections, c) end
    for _, c in ipairs(connsB) do table.insert(sliderConnections, c) end

    local boxConn = RunService.RenderStepped:Connect(function()
        if not NodeA or not NodeB or not SelectionBox then return end
        if not NodeA.Parent or not NodeB.Parent or not SelectionBox.Parent then return end

        local ax = NodeA.AbsolutePosition.X + (NodeA.AbsoluteSize.X / 2)
        local ay = NodeA.AbsolutePosition.Y + (NodeA.AbsoluteSize.Y / 2)
        local bx = NodeB.AbsolutePosition.X + (NodeB.AbsoluteSize.X / 2)
        local by = NodeB.AbsolutePosition.Y + (NodeB.AbsoluteSize.Y / 2)

        local minX = math.min(ax, bx)
        local minY = math.min(ay, by)
        local maxX = math.max(ax, bx)
        local maxY = math.max(ay, by)

        SelectionBox.Position = UDim2.new(0, minX, 0, minY)
        SelectionBox.Size = UDim2.new(0, maxX - minX, 0, maxY - minY)
    end)
    table.insert(sliderConnections, boxConn)
end

-- Начальное создание ползунков
