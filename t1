local SCRIPT_GUI_NAME = "MM2_AIO_Gui"
local SCRIPT_TAG_NAME = "MM2_AIO_ACTIVE_MARKER"

local function FindExistingInstance(name)    
    local targets = {}
    local okHui, hui = pcall(function() return (gethui and gethui()) end)
    if okHui and hui then table.insert(targets, hui) end

    local okCore, core = pcall(function() return game:GetService("CoreGui") end)
    if okCore and core then table.insert(targets, core) end

    local lp = game:GetService("Players").LocalPlayer
    if lp then
        local pg = lp:FindFirstChild("PlayerGui")
        if pg then table.insert(targets, pg) end
    end

    for _, container in ipairs(targets) do
        local found = container:FindFirstChild(name)
        if found then return found end
    end
    return nil
end

if FindExistingInstance(SCRIPT_GUI_NAME) or FindExistingInstance(SCRIPT_TAG_NAME) then
    warn("[MM2 AIO] Скрипт уже запущен в текущей сессии! Дублирующий запуск отменен.")
    return
end

