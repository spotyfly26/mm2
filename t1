        local m = math.floor((remaining % 3600) / 60)
        local s = math.floor(remaining % 60)

        if RejoinParagraph then
            pcall(function()
                if RejoinPending then
                    RejoinParagraph:SetDesc("Ожидание лобби для перезахода...")
                else
                    RejoinParagraph:SetDesc(string.format("До перезахода: %02d:%02d:%02d", h, m, s))
                end
            end)
        end

        if remaining <= 0 and not isTeleporting then
            RejoinPending = true
            local canSafelyRejoin = (CurrentState == State.WaitingForRound) or (not rt:CheckIfGameInProgress())
            if canSafelyRejoin then
