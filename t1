-- === АВТО-ГОЛОСОВАНИЕ ===
local LastVoteSession = ""

local function GetMapPriority(mapName)
    local lowerMap = string.lower(mapName)
    for i, name in ipairs(MAP_PRIORITIES) do
        if string.lower(name) == lowerMap then return i end
    end
    return 999
end

local function ScanVotePads()
    local currentMaps = {}
    local lobby = Workspace:FindFirstChild("Lobby")
    local votePadsFolder = lobby and lobby:FindFirstChild("VotePads")
    if not votePadsFolder then return currentMaps, "" end

    local allNames = {}
    for _, pad in ipairs(votePadsFolder:GetChildren()) do
        if pad:IsA("BasePart") or pad:IsA("Model") then
            local voteInfoGui = pad:FindFirstChild("VoteInfoGui", true)
            if voteInfoGui then
                if (voteInfoGui:IsA("SurfaceGui") or voteInfoGui:IsA("BillboardGui") or voteInfoGui:IsA("ScreenGui")) and not (voteInfoGui).Enabled then
                    continue
                end

                local mapName = nil
                for _, desc in ipairs(voteInfoGui:GetDescendants()) do
                    if desc:IsA("TextLabel") and desc.Visible and desc.TextTransparency < 1 then
                        local isParentVisible = true
                        local parent = desc.Parent
                        while parent and parent ~= voteInfoGui do
                            if parent:IsA("GuiObject") then
                                if not parent.Visible then
                                    isParentVisible = false
                                    break
                                end
                                if parent:IsA("CanvasGroup") and (parent).GroupTransparency >= 1 then
                                    isParentVisible = false
                                    break
                                end
                            end
                            parent = parent.Parent
                        end

                        if isParentVisible then
                            local cleanText = string.gsub(desc.Text, "^%s*(.-)%s*$", "%1")
                            local lower = string.lower(cleanText)
                            if cleanText ~= "" and lower ~= "label" and not string.find(lower, "votes") then
                                if desc.Name == "MapName" or not mapName then
                                    mapName = cleanText
                                end
                            end
                        end
                    end
                end

                if mapName and mapName ~= "" then
                    table.insert(allNames, mapName)
                    local tpPart = pad:IsA("BasePart") and pad or (pad:IsA("Model") and (pad.PrimaryPart or pad:FindFirstChildWhichIsA("BasePart"))) or pad:FindFirstChildWhichIsA("BasePart")
                    if tpPart then
                        currentMaps[mapName] = tpPart.CFrame + Vector3.new(0, 1.0, 0)
                    end
                end
            end
        end
    end

    table.sort(allNames)
    local sessionStr = table.concat(allNames, "|")

    return currentMaps, sessionStr
end

-- Основной цикл автофарма с защитой от падений
local function RunFarmCycle()
    while not IsTerminated do
        if SETTINGS.AutoFarmEnabled then
            local ok, err = pcall(function()
                if CurrentState == State.WaitingForRound then WaitingForRound()
                elseif CurrentState == State.Action then ActionState()
                elseif CurrentState == State.WaitingForRoundEnd then waitForRoundEnd()
                end
            end)
            if not ok then
                warn("[MM2 AIO] Farm loop error: " .. tostring(err))
                BagIsFull = false
                Working = false
                CurrentState = State.WaitingForRound
                task.wait(1)
            end
        end
        task.wait()
    end
end

task.spawn(function()
    while not IsTerminated do
        local ok, err = pcall(RunFarmCycle)
        if not ok and not IsTerminated then
            warn("[MM2 AIO] Farm loop restarted after error: " .. tostring(err))
            task.wait(1)
        end
    end
end)

-- Основной цикл авто-голосования
task.spawn(function()
    while not IsTerminated and task.wait(0.5) do
        if not SETTINGS.AutoVoteEnabled then continue end
        if rt:CheckIfGameInProgress() then 
            continue 
        end

        local availableMaps, currentSession = ScanVotePads()
        
        if currentSession ~= "" and currentSession ~= LastVoteSession then
            LastVoteSession = currentSession
            HasVoted = false
            UpdateStatus("Голос: Новое голосование", Color3.fromRGB(150, 200, 255))
        end
        
        if HasVoted then continue end
        
        local mapNames = {}
        for name, _ in pairs(availableMaps) do table.insert(mapNames, name) end
        if #mapNames < 2 then continue end

        local bestMap, bestPriority, bestCFrame = nil, 999, nil
        for name, tpCFrame in pairs(availableMaps) do
            local priority = GetMapPriority(name)
            if priority < bestPriority then
                bestPriority = priority
                bestMap = name
                bestCFrame = tpCFrame
            end
        end

        if bestMap and bestPriority < 999 and bestCFrame then
            local maxVotes = SETTINGS.VoteSpamEnabled and 11 or 1
            UpdateStatus(string.format("Голос: Старт (%s, %s)", bestMap, SETTINGS.VoteSpamEnabled and "спам до 11" or "1 голос"), Color3.fromRGB(50, 255, 255))

            local voteCount = 0
            isVotingNoclip = true

            local currentChar = LocalPlayer.Character
            local currentHrp = currentChar and (currentChar:FindFirstChild("HumanoidRootPart") or currentChar.PrimaryPart)             
            local currentHum = currentChar and currentChar:FindFirstChildOfClass("Humanoid")

            while voteCount < maxVotes and not IsTerminated and SETTINGS.AutoVoteEnabled do
                if rt:CheckIfGameInProgress() then break end

                if not currentChar or not currentHrp or not currentHum or currentHum.Health <= 0 then
                    currentChar = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
                    currentHrp = (currentChar:WaitForChild("HumanoidRootPart", 5) or currentChar.PrimaryPart)                     
                    currentHum = (currentChar:WaitForChild("Humanoid", 5))                
                end

                if not currentHrp or not currentHum then break end

                updateBodyPartsCache()
                for _, part in ipairs(rt.cachedBodyParts) do
                    if part and part.Parent then part.CanCollide = false end
                end

                local holdV = Instance.new("BodyVelocity")
                holdV.Name = "VoteHover"
                holdV.Velocity = Vector3.zero
                holdV.MaxForce = Vector3.new(0, 9e9, 0)
                holdV.Parent = currentHrp

                currentHrp.AssemblyLinearVelocity = Vector3.zero
                currentHrp.AssemblyAngularVelocity = Vector3.zero
                currentChar:PivotTo(bestCFrame)

                voteCount = voteCount + 1
                UpdateStatus(string.format("Голос: [%s] (%d/%d)", bestMap, voteCount, maxVotes), Color3.fromRGB(50, 255, 255))

                task.wait(0.15)

                if holdV and holdV.Parent then holdV:Destroy() end

                if not SETTINGS.VoteSpamEnabled or voteCount >= maxVotes or rt:CheckIfGameInProgress() or not SETTINGS.AutoVoteEnabled then
                    break
                end

                pcall(function()
                    currentHum.Health = 0
                    currentChar:BreakJoints()
                end)

                currentChar = LocalPlayer.CharacterAdded:Wait()
                currentHrp = (currentChar:WaitForChild("HumanoidRootPart", 5) or currentChar.PrimaryPart)                 
                currentHum = (currentChar:WaitForChild("Humanoid", 5))
            end

            isVotingNoclip = false
            HasVoted = true
            UpdateStatus(string.format("Голос: Завершено (%d за %s)", voteCount, bestMap), Color3.fromRGB(100, 255, 100))
        end
    end
end)

