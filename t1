-- === ПОИСК БЛИЖАЙШЕЙ МОНЕТЫ С УПРЕЖДЕНИЕМ И ЗОНАМИ ТВИНКА ===
local function GetNearestCoin()    
    local char = rt:Character()
    if not char or not char.PrimaryPart then return nil end

    local myPos = char.PrimaryPart.Position

    -- Поиск позиции и вектора движения твинка
    local twinPos = nil
    local twinPredPos = nil
    local twinPlr = nil
    local twinName = SETTINGS.TwinName

    if SETTINGS.TwinAvoidEnabled and twinName and twinName ~= "" then
        local cleanTwin = string.lower(string.gsub(twinName, "^%s*(.-)%s*$", "%1"))
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and string.lower(plr.Name) == cleanTwin then
                if IsPlayerActuallyAlive(plr) then
                    local tChar = plr.Character
                    local tHrp = tChar and (tChar.PrimaryPart or tChar:FindFirstChild("HumanoidRootPart") or tChar:FindFirstChildWhichIsA("BasePart"))
                    if tHrp then
                        twinPos = tHrp.Position
                        twinPlr = plr
                        local vel = tHrp.AssemblyLinearVelocity
                        if vel and vel.Magnitude > 3 then
                            twinPredPos = twinPos + (vel.Unit * math.min(vel.Magnitude * 1.8, 50))
                        end
                    end
                end
                break
            end
        end
    end

    local bestCoin = nil
    local bestDist = math.huge

    local fallbackCoin = nil
    local fallbackDist = math.huge

    local avoidRadius = SETTINGS.TwinAvoidRadius or 30

    for coin, _ in pairs(rt.cachedCoins) do
        if coin and rt.coinContainer and coin.Parent == rt.coinContainer and not isCoinTouched(coin) and coin:FindFirstChildWhichIsA("TouchTransmitter") then
            local coinPos = coin.Position
            local myDist = (coinPos - myPos).Magnitude

            if myDist < fallbackDist then
                fallbackDist = myDist
                fallbackCoin = coin
            end

            local isTwinZone = false
            if twinPos then
                if myDist > 12 then
                    local twinDist = (coinPos - twinPos).Magnitude
                    local predDist = twinPredPos and (coinPos - twinPredPos).Magnitude or math.huge

                    if (twinDist < avoidRadius)
                        or (predDist < 18)
                        or (twinDist < myDist)
                        or (twinDist == myDist and twinPlr and LocalPlayer.Name < twinPlr.Name) then
                        isTwinZone = true
                    end
                end
            end

            if not isTwinZone then
                if myDist < bestDist then
                    bestDist = myDist
                    bestCoin = coin
                end
            end
        else
            rt.cachedCoins[coin] = nil
        end
    end

    return bestCoin or fallbackCoin
end

-- === УНИВЕРСАЛЬНЫЙ UI-ПАРСЕР СУМКИ (ТЕЛЕФОН / ПЛАНШЕТ / ПК) ===
local function SetupBagParser()
    task.spawn(function()
        local playerGui = LocalPlayer:WaitForChild("PlayerGui", 15)
        if not playerGui then return end

        local hookedContainers = {}

        local function isBagActuallyVisible(bagFrame, coinsLabel)            
            if not bagFrame.Visible then return false end
            if coinsLabel and (not coinsLabel.Visible or coinsLabel.TextTransparency >= 1) then
                return false
            end
            if bagFrame.AbsoluteSize.X <= 0 or bagFrame.AbsoluteSize.Y <= 0 then
                return false
            end

            local curr = bagFrame.Parent
            while curr and curr:IsA("GuiObject") do
                if not (curr).Visible then
                    return false
                end
                if curr:IsA("CanvasGroup") and (curr).GroupTransparency >= 1 then
                    return false
                end
                curr = curr.Parent
            end
            return true
        end

        local function hookContainer(container)
            if not container or hookedContainers[container] then return end
            hookedContainers[container] = true

            local function bindToCurrencyBag(bagFrame)
                if not bagFrame:IsA("GuiObject") then return end

                local currencyFrame = bagFrame:FindFirstChild("CurrencyFrame") or bagFrame:WaitForChild("CurrencyFrame", 2)
                local icon = currencyFrame and (currencyFrame:FindFirstChild("Icon") or currencyFrame:WaitForChild("Icon", 2))
                local coinsLabel = icon and (icon:FindFirstChild("Coins") or icon:WaitForChild("Coins", 2)) 
                
                if not coinsLabel or not coinsLabel:IsA("TextLabel") then return end

                local fullLabel = (bagFrame:FindFirstChild("Full"))                
                local fullBagIcon = (bagFrame:FindFirstChild("FullBagIcon"))
                local lastCount = tonumber(coinsLabel.Text) or 0

                local function checkFull()
                    if not isBagActuallyVisible(bagFrame, coinsLabel) then return end
                    local count = tonumber(coinsLabel.Text) or 0
                    
                    if count < 40 then
                        BagIsFull = false
                        return
                    end

                    local isFull = false

                    if fullLabel and fullLabel.Visible and fullLabel.TextTransparency < 1 and fullLabel.Text == "Full!" then
                        isFull = true
                    end

                    local iconObj = bagFrame:FindFirstChild("FullBagIcon")
                    if iconObj and iconObj:IsA("ImageLabel") and iconObj.Visible and iconObj.ImageTransparency < 1 then
                        isFull = true
                    end

                    local isEvent = (bagFrame.Name ~= "Coin")
                    local maxLimit = isEvent and 50 or (rt:IsElite() and 50 or 40)

                    if count >= maxLimit then
                        isFull = true
                    end

                    BagIsFull = isFull
                end

                RegisterConnection(coinsLabel:GetPropertyChangedSignal("Text"):Connect(function()
                    if IsTerminated then return end
                    if not isBagActuallyVisible(bagFrame, coinsLabel) then return end

                    local currentCount = tonumber(coinsLabel.Text) or 0
                    if currentCount > lastCount then
                        local gained = currentCount - lastCount
                        StatsData.CoinsCollected = StatsData.CoinsCollected + gained
                        BagCoinCount = currentCount
                        CurrentRoundCoins = currentCount
                        ActiveCurrencyName = bagFrame.Name
                    elseif currentCount < lastCount then
                        BagCoinCount = currentCount
                        CurrentRoundCoins = currentCount
                    end

                    lastCount = currentCount
                    checkFull()
                end))

                RegisterConnection(bagFrame:GetPropertyChangedSignal("Visible"):Connect(function()
                    if IsTerminated then return end
                    if RoundInProgress() and isBagActuallyVisible(bagFrame, coinsLabel) then
                        ActiveCurrencyName = bagFrame.Name
                        BagCoinCount = tonumber(coinsLabel.Text) or 0
                        checkFull()
                    end
                end))

                local currParent = bagFrame.Parent
                while currParent and currParent:IsA("GuiObject") do
                    local pObj = currParent                     
                    RegisterConnection(pObj:GetPropertyChangedSignal("Visible"):Connect(function()
                        if IsTerminated then return end
                        if RoundInProgress() and isBagActuallyVisible(bagFrame, coinsLabel) then
                            ActiveCurrencyName = bagFrame.Name
                            BagCoinCount = tonumber(coinsLabel.Text) or 0
                            checkFull()
                        end
                    end))
                    currParent = currParent.Parent
                end

                if fullLabel then
                    RegisterConnection(fullLabel:GetPropertyChangedSignal("Visible"):Connect(function()
                        if IsTerminated then return end
                        checkFull()
                    end))

                    RegisterConnection(fullLabel:GetPropertyChangedSignal("Text"):Connect(function()
                        if IsTerminated then return end
                        checkFull()
                    end))

                    RegisterConnection(fullLabel:GetPropertyChangedSignal("TextTransparency"):Connect(function()
                        if IsTerminated then return end
                        checkFull()
                    end))
                end

                if fullBagIcon then
                    RegisterConnection(fullBagIcon:GetPropertyChangedSignal("Visible"):Connect(function()
                        if IsTerminated then return end
                        checkFull()
                    end))

                    RegisterConnection(fullBagIcon:GetPropertyChangedSignal("ImageTransparency"):Connect(function()
                        if IsTerminated then return end
                        checkFull()
                    end))
                end

                if RoundInProgress() and isBagActuallyVisible(bagFrame, coinsLabel) then
                    ActiveCurrencyName = bagFrame.Name
                    BagCoinCount = tonumber(coinsLabel.Text) or 0
                    checkFull()
                end
            end

            for _, bag in ipairs(container:GetChildren()) do
                bindToCurrencyBag(bag)
            end

            RegisterConnection(container.ChildAdded:Connect(function(child)
                if IsTerminated then return end
                bindToCurrencyBag(child)
            end))
        end

        local function scanAndHookContainers(mainGui)
            if mainGui.Name ~= "MainGUI" then return end

            local gameObj = mainGui:FindFirstChild("Game")
            local gameBags = gameObj and gameObj:FindFirstChild("CoinBags")
            local gameContainer = gameBags and gameBags:FindFirstChild("Container")
            if gameContainer then
                hookContainer(gameContainer)
            end

            local lobby = mainGui:FindFirstChild("Lobby")
            local dock = lobby and lobby:FindFirstChild("Dock")
            local dockBags = dock and dock:FindFirstChild("CoinBags")
            local dockContainer = dockBags and dockBags:FindFirstChild("Container")
            if dockContainer then
                hookContainer(dockContainer)
            end

            if not gameContainer and not dockContainer then
                local anyBags = mainGui:FindFirstChild("CoinBags", true)
                local anyContainer = anyBags and anyBags:FindFirstChild("Container")
                if anyContainer then
                    hookContainer(anyContainer)
                end
            end

            RegisterConnection(mainGui.DescendantAdded:Connect(function(desc)
                if IsTerminated then return end
                if desc.Name == "Container" and desc.Parent and desc.Parent.Name == "CoinBags" then
                    hookContainer(desc)
                end
            end))
        end

        local existingMain = playerGui:FindFirstChild("MainGUI")
        if existingMain then
            task.spawn(scanAndHookContainers, existingMain)
        end

        RegisterConnection(playerGui.ChildAdded:Connect(function(child)
            if child.Name == "MainGUI" then
                task.spawn(scanAndHookContainers, child)
            end
        end))
    end)
end
SetupBagParser()

