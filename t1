local SCRIPT_RAW_URL = ""

local function QueueScriptForTeleport()
    local qot = queue_on_teleport 
        or (syn and syn.queue_on_teleport) 
        or (fluxus and fluxus.queue_on_teleport)

    if typeof(qot) == "function" then
        pcall(function()
            local payload = string.format([=[
                pcall(function()
                    local url = %q
                    if url ~= "" then
                        loadstring(game:HttpGet(url))()
                    else
                        local rf = readfile or (syn and syn.readfile)
                        local isf = isfile or (syn and syn.isfile)
                        if typeof(isf) == "function" and typeof(rf) == "function" then
                            local searchFiles = {"20gm.lua", "scripts/20gm.lua", "autoexecute/20gm.lua"}
                            for _, f in ipairs(searchFiles) do
                                if isf(f) then
                                    loadstring(rf(f))()
                                    break
                                end
                            end
                        end
                    end
                end)
            ]=], SCRIPT_RAW_URL)
            qot(payload)
        end)
    end
end

