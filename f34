local LastVoteSession = ""

local function GetMapPriority(mapName: string): (number, boolean)
    local key = NormalizeMapKey(mapName)
    local cachedArea = MapSizesCache[key]

    -- 1. Если карта ещё не исследована и отсутствует в базе:
    -- Назначаем наивысший приоритет (меньше 0), чтобы скрипт голосовал за неё
    if not cachedArea or cachedArea <= 0 then
        return -1, false
    end

    -- 2. Если карта известна: приоритет равен её площади Spawns XZ (чем меньше площадь, тем выше приоритет)
    return cachedArea, true
end

local function ScanVotePads()
    local currentMaps = {}
    local lobby = Workspace:FindFirstChild("Lobby")
    local votePadsFolder = lobby and lobby:FindFirstChild("VotePads")
    if not votePadsFolder then return currentMaps, "" end

    local allNames = {}
    for _, pad in ipairs(votePadsFolder:GetChildren()) do
        if pad:IsA("BasePart") or pad:IsA("Model") then
            local voteInfoGui = pad:FindFirstChild("VoteInfoGui", true)
            if voteInfoGui then
                -- Проверка активности интерфейса голосования на стенде
                if (voteInfoGui:IsA("SurfaceGui") or voteInfoGui:IsA("BillboardGui") or voteInfoGui:IsA("ScreenGui")) and not (voteInfoGui :: any).Enabled then
                    continue
                end

                local mapName: string? = nil
                for _, desc in ipairs(voteInfoGui:GetDescendants()) do
                    if desc:IsA("TextLabel") and desc.Visible and desc.TextTransparency < 1 then
                        local isParentVisible = true
                        local parent = desc.Parent
                        while parent and parent ~= voteInfoGui do
                            if parent:IsA("GuiObject") then
                                if not parent.Visible then
                                    isParentVisible = false
                                    break
                                end
                                if parent:IsA("CanvasGroup") and (parent :: CanvasGroup).GroupTransparency >= 1 then
                                    isParentVisible = false
                                    break
                                end
                            end
                            parent = parent.Parent
                        end

                        if isParentVisible then
                            local cleanText = string.gsub(desc.Text, "^%s*(.-)%s*$", "%1")
                            local lower = string.lower(cleanText)
                            if cleanText ~= "" and lower ~= "label" and not string.find(lower, "votes") then
                                if desc.Name == "MapName" or not mapName then
                                    mapName = cleanText
                                end
                            end
                        end
                    end
                end

                if mapName and mapName ~= "" then
                    table.insert(allNames, mapName)
                    local padPart: BasePart? = nil
                    if pad:IsA("BasePart") and pad.Name == "Pad" then
                        padPart = pad
                    elseif pad:IsA("Model") then
                        padPart = (pad:FindFirstChild("Pad") or pad:FindFirstChild("Pad", true) or pad.PrimaryPart or pad:FindFirstChildWhichIsA("BasePart")) :: BasePart?
                    elseif pad:IsA("BasePart") then
                        padPart = pad
                    end

                    if padPart then
                        -- Смещение в самую нижнюю область 3D-зоны Pad (чуть ниже уровня пола) в лежачем положении (-90 градусов по X)
                        local halfHeight = (padPart.Size.Y > 1) and (padPart.Size.Y * 0.5) or 2.5
                        local targetPos = padPart.Position - Vector3.new(0, halfHeight - 0.7, 0)
                        local padLook = padPart.CFrame.LookVector
                        local flatLook = Vector3.new(padLook.X, 0, padLook.Z)
                        local baseCFrame = (flatLook.Magnitude > 0.01)
                            and CFrame.new(targetPos, targetPos + flatLook)
                            or CFrame.new(targetPos)
                        currentMaps[mapName] = baseCFrame * CFrame.Angles(math.rad(-90), 0, 0)
                    end
                end
            end
        end
    end

    table.sort(allNames)
    local sessionStr = table.concat(allNames, "|")

    return currentMaps, sessionStr
end

-- Основной цикл автофарма с защитой от падений
local function RunFarmCycle()
    while not IsTerminated do
        if SETTINGS.AutoFarmEnabled then
            local ok, err = pcall(function()
                if CurrentState == State.WaitingForRound then WaitingForRound()
                elseif CurrentState == State.Action then ActionState()
                elseif CurrentState == State.WaitingForRoundEnd then waitForRoundEnd()
                end
            end)
            if not ok then
                warn("[MM2 AIO] Farm loop error: " .. tostring(err))
                pcall(UnequipKnife)
                BagIsFull = false
                ChangeState(State.WaitingForRound)
                task.wait(1)
            end
        else
            -- Фарм выключен: нет смысла крутить цикл каждый кадр
            task.wait(0.25)
        end
        task.wait()
    end
end

task.spawn(function()
    while not IsTerminated do
        local ok, err = pcall(RunFarmCycle)
        if not ok and not IsTerminated then
            warn("[MM2 AIO] Farm loop restarted after error: " .. tostring(err))
            task.wait(1)
        end
    end
end)

-- Основной цикл авто-голосования
task.spawn(function()
    while not IsTerminated and task.wait(0.5) do
        if not SETTINGS.AutoVoteEnabled then continue end
        if rt:CheckIfGameInProgress() then 
            continue 
        end

        local availableMaps, currentSession = ScanVotePads()
        
        if currentSession ~= "" and currentSession ~= LastVoteSession then
            LastVoteSession = currentSession
            HasVoted = false
            UpdateStatus("Голос: Новое голосование", Color3.fromRGB(150, 200, 255))
        end
        
        if HasVoted then continue end
        
        local mapNames = {}
        for name, _ in pairs(availableMaps) do table.insert(mapNames, name) end
        if #mapNames < 2 then continue end

        -- Разделение доступных стендов на новые (неисследованные) и уже известные
        local unknownMaps: { { name: string, cframe: CFrame } } = {}
        local knownMaps: { { name: string, area: number, cframe: CFrame } } = {}

        for name, tpCFrame in pairs(availableMaps) do
            local priority, isKnown = GetMapPriority(name)
            if not isKnown then
                table.insert(unknownMaps, { name = name, cframe = tpCFrame })
            else
                table.insert(knownMaps, { name = name, area = priority, cframe = tpCFrame })
            end
        end

        local bestMap: string? = nil
        local bestCFrame: CFrame? = nil
        local voteReason = ""

        -- 1. Если есть неизвестные карты, отдаём приоритет им (если их несколько — выбираем случайную)
        if #unknownMaps > 0 then
            local chosen = unknownMaps[math.random(1, #unknownMaps)]
            bestMap = chosen.name
            bestCFrame = chosen.cframe
            voteReason = string.format("новая карта, исследование [%d в пуле]", #unknownMaps)
        elseif #knownMaps > 0 then
            -- 2. Если все карты известны — выбираем самую компактную (с наименьшей площадью)
            table.sort(knownMaps, function(a, b)
                return a.area < b.area
            end)
            local chosen = knownMaps[1]
            bestMap = chosen.name
            bestCFrame = chosen.cframe
            voteReason = string.format("компактная: %d студов", chosen.area)
        end

        if bestMap and bestCFrame then
            local maxVotes = SETTINGS.VoteSpamEnabled and 11 or 1
            UpdateStatus(string.format("Голос: [%s] (%s | %s)", bestMap, voteReason, SETTINGS.VoteSpamEnabled and "спам до 11" or "1 голос"), Color3.fromRGB(50, 255, 255))

            local voteCount = 0
            isVotingNoclip = true

            local currentChar = LocalPlayer.Character
            local currentHrp = currentChar and (currentChar:FindFirstChild("HumanoidRootPart") or currentChar.PrimaryPart) :: BasePart?
            local currentHum = currentChar and currentChar:FindFirstChildOfClass("Humanoid")

            while voteCount < maxVotes and not IsTerminated and SETTINGS.AutoVoteEnabled do
                if rt:CheckIfGameInProgress() then break end

                -- Если персонаж еще не появился или мертв — ждем один раз
                if not currentChar or not currentHrp or not currentHum or currentHum.Health <= 0 then
                    currentChar = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
                    currentHrp = (currentChar:WaitForChild("HumanoidRootPart", 5) or currentChar.PrimaryPart) :: BasePart?
                    currentHum = currentChar:WaitForChild("Humanoid", 5) :: Humanoid?
                end

                if not currentHrp or not currentHum then break end

                -- Мгновенно отключаем коллизию нового тела
                updateBodyPartsCache()
                for _, part in ipairs(rt.cachedBodyParts) do
                    if part and part.Parent then part.CanCollide = false end
                end

                if currentHum then currentHum.PlatformStand = true end

                -- Зависаем в воздухе без падения (BodyVelocity + BodyGyro)
                local holdV = currentHrp:FindFirstChild("VoteHover") or Instance.new("BodyVelocity")
                holdV.Name = "VoteHover"
                holdV.Velocity = Vector3.zero
                holdV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                holdV.Parent = currentHrp

                local holdG = currentHrp:FindFirstChild("VoteGyro") or Instance.new("BodyGyro")
                holdG.Name = "VoteGyro"
                holdG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
                holdG.CFrame = bestCFrame
                holdG.P = 3000
                holdG.Parent = currentHrp

                currentHrp.AssemblyLinearVelocity = Vector3.zero
                currentHrp.AssemblyAngularVelocity = Vector3.zero
                currentChar:PivotTo(bestCFrame)

                voteCount = voteCount + 1
                UpdateStatus(string.format("Голос: [%s] (%d/%d)", bestMap, voteCount, maxVotes), Color3.fromRGB(50, 255, 255))

                -- Пауза для фиксации пакета координат сервером MM2
                task.wait(0.15)

                -- Если спам выключен или лимит достигнут — выходим сразу БЕЗ сброса (остаемся парить под полом)
                if not SETTINGS.VoteSpamEnabled or voteCount >= maxVotes or rt:CheckIfGameInProgress() or not SETTINGS.AutoVoteEnabled then
                    break
                end

                -- Для следующей итерации спама удаляем ховер и сбрасываем персонажа
                if holdV and holdV.Parent then holdV:Destroy() end
                if holdG and holdG.Parent then holdG:Destroy() end

                -- Сброс персонажа для получения следующего голоса
                pcall(function()
                    currentHum.Health = 0
                    currentChar:BreakJoints()
                end)

                -- Ждем нового персонажа строго ОДИН раз
                currentChar = LocalPlayer.CharacterAdded:Wait()
                currentHrp = (currentChar:WaitForChild("HumanoidRootPart", 5) or currentChar.PrimaryPart) :: BasePart?
                currentHum = currentChar:WaitForChild("Humanoid", 5) :: Humanoid?
                -- В следующей итерации currentChar и currentHrp УЖЕ готовы,
                -- поэтому телепорт произойдет мгновенно в 0-й миллисекунде появления!
            end

            HasVoted = true
            UpdateStatus(string.format("Голос: Отдан (%d за %s). Ожидание раунда...", voteCount, bestMap), Color3.fromRGB(100, 255, 100))

            -- Остаемся парить в нижней области стенда под полом в noclip до старта раунда
            while not IsTerminated and SETTINGS.AutoVoteEnabled and not rt:CheckIfGameInProgress() do
                if currentChar and currentHrp and currentHum and currentHum.Health > 0 then
                    currentHum.PlatformStand = true
                    currentHrp.AssemblyLinearVelocity = Vector3.zero
                    currentHrp.AssemblyAngularVelocity = Vector3.zero
                    local holdG = currentHrp:FindFirstChild("VoteGyro") :: BodyGyro?
                    if holdG then
                        holdG.CFrame = bestCFrame
                    end
                else
                    break
                end
                task.wait(0.25)
            end

            -- Раунд начался или скрипт/голос отключен — плавно выключаем ховер и ноклип
            isVotingNoclip = false
            if currentHrp then
                local vh = currentHrp:FindFirstChild("VoteHover")
                if vh then vh:Destroy() end
                local vg = currentHrp:FindFirstChild("VoteGyro")
                if vg then vg:Destroy() end
                currentHrp.AssemblyLinearVelocity = Vector3.zero
                currentHrp.AssemblyAngularVelocity = Vector3.zero
            end
            if currentHum then
                currentHum.PlatformStand = false
            end
            UpdateStatus(string.format("Голос: Завершено (%d за %s)", voteCount, bestMap), Color3.fromRGB(100, 255, 100))
        end
    end
end)

