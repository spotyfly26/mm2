    print("[MM2 AIO] Обнаружено окно друзей (Join/Friends). Ожидание готовности кнопки Play...")
    UpdateStatus("Окно друзей: ожидание готовности Play...", Color3.fromRGB(120, 200, 255))

    -- Пульсирующий клик по Play: в MM2 кнопка Play подключается только ПОСЛЕ
    -- того, как завершится построение списка друзей UpdateList() (строка 449 исходника MM2).
    task.spawn(function()
        local startTime = os.clock()
        local fs = firesignal or (syn and syn.firesignal)
        local gc = getconnections or (syn and syn.getconnections)
        local vim = game:GetService("VirtualInputManager")

        while not IsTerminated and joinGui and joinGui.Parent and (os.clock() - startTime < 15) do
            local friends = joinGui:FindFirstChild("Friends")
            local playBtn = (friends and friends:FindFirstChild("Play")) or joinGui:FindFirstChild("Play", true)

            if playBtn and playBtn:IsA("GuiButton") then
                -- 1. firesignal (MouseButton1Click и Activated)
                if typeof(fs) == "function" then
                    pcall(function() fs(playBtn.MouseButton1Click) end)
                    pcall(function() fs(playBtn.Activated) end)
                end

                -- 2. getconnections
                if typeof(gc) == "function" then
                    for _, evName in ipairs({"MouseButton1Click", "Activated"}) do
                        local sOk, sig = pcall(function() return (playBtn :: any)[evName] end)
                        if sOk and sig then
                            local cOk, conns = pcall(gc, sig)
                            if cOk and typeof(conns) == "table" and #conns > 0 then
                                for _, c in ipairs(conns) do
                                    pcall(function() c:Fire() end)
                                end
                            end
                        end
                    end
                end

                -- 3. VirtualInputManager (мягкий физический клик по координатам)
                if playBtn:IsA("GuiObject") and playBtn.AbsoluteSize.X > 0 then
                    pcall(function()
                        local absPos = playBtn.AbsolutePosition
                        local absSize = playBtn.AbsoluteSize
                        local cx = absPos.X + absSize.X / 2
                        local cy = absPos.Y + absSize.Y / 2
                        vim:SendMouseButtonEvent(cx, cy, 0, true, game, 0)
                        task.wait(0.03)
                        vim:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
                    end)
                end
            end

            task.wait(0.2)
        end

        if not joinGui or not joinGui.Parent then
            print("[MM2 AIO] Окно друзей (Join/Friends) успешно закрыто через Play! Родной цикл MM2 запущен.")
            UpdateStatus("Окно друзей закрыто (Play)", Color3.fromRGB(100, 255, 100))
        end
    end)
