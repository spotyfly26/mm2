-- СИСТЕМА УЧЕТА ТОКЕНОВ В ИНВЕНТАРЕ (BATTLEPASS / EVENT CURRENCY)
-- =====================================================================
-- Путь: CrossPlatform.Halloween2026.MainEvent.Main.BattlePass.Title.Tokens.Container.TextLabel
local EVENT_TOKENS_CONFIG = {
    ScreenGui = "CrossPlatform",
    EventFolder = "Halloween2026", -- Имя текущего ивента (авто-определяется, если изменится)
    SubPath = {"MainEvent", "Main", "BattlePass", "Title", "Tokens", "Container"}
}

local cachedTokensLabel: TextLabel? = nil
local tokensChangedConn: RBXScriptConnection? = nil
local tokensAncestryConn: RBXScriptConnection? = nil

local function FindInventoryTokensLabel(): TextLabel?
    local pGui = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:FindFirstChild("PlayerGui")
    if not pGui then return nil end

    local cp = pGui:FindFirstChild(EVENT_TOKENS_CONFIG.ScreenGui) or pGui:FindFirstChild(EVENT_TOKENS_CONFIG.ScreenGui, true)
    if not cp then return nil end

    -- 1. Приоритетная проверка прямого пути текущего ивента:
    local eventFolder = cp:FindFirstChild(EVENT_TOKENS_CONFIG.EventFolder)
    if eventFolder then
        local curr: Instance? = eventFolder
        for _, name in ipairs(EVENT_TOKENS_CONFIG.SubPath) do
            if not curr then break end
            curr = curr:FindFirstChild(name)
        end
        if curr then
            local lbl = curr:FindFirstChild("TextLabel") or curr:FindFirstChildWhichIsA("TextLabel")
            if lbl and lbl:IsA("TextLabel") then
                return lbl
            end
        end
    end

    -- 2. Умный fallback: автоматический поиск папки любого другого ивента в CrossPlatform
    -- (если сменился сезон: Xmas, Easter, Summer и т.д. без необходимости правок кода)
    for _, child in ipairs(cp:GetChildren()) do
        if child:IsA("GuiObject") or child:IsA("Folder") then
            local curr: Instance? = child
            for _, name in ipairs(EVENT_TOKENS_CONFIG.SubPath) do
                if not curr then break end
                curr = curr:FindFirstChild(name)
            end
            if curr then
                local lbl = curr:FindFirstChild("TextLabel") or curr:FindFirstChildWhichIsA("TextLabel")
                if lbl and lbl:IsA("TextLabel") then
                    return lbl
                end
            end
        end
    end

    -- 3. Глубокий запасной fallback через Tokens -> Container
    local tokens = cp:FindFirstChild("Tokens", true)
    if tokens then
        local container = tokens:FindFirstChild("Container")
        local lbl = container and (container:FindFirstChild("TextLabel") or container:FindFirstChildWhichIsA("TextLabel"))
        if lbl and lbl:IsA("TextLabel") then
            return lbl
        end
    end

    return nil
end

local function HookInventoryTokensLabel(lbl: TextLabel)
    if cachedTokensLabel == lbl then return end
    if tokensChangedConn then
        tokensChangedConn:Disconnect()
        tokensChangedConn = nil
    end
    if tokensAncestryConn then
        tokensAncestryConn:Disconnect()
        tokensAncestryConn = nil
    end

    cachedTokensLabel = lbl
    TotalInventoryTokens = lbl.Text
    updateStatsDisplay()

    -- Реактивное обновление с 0% нагрузки на ЦП (срабатывает только при физическом изменении текста)
    tokensChangedConn = lbl:GetPropertyChangedSignal("Text"):Connect(function()
        if IsTerminated then return end
        TotalInventoryTokens = lbl.Text
        -- Если фарм выключен (в лобби) — обновляем сразу; во время фарма отрисовку берет на себя 1-секундный таймер
        if not SETTINGS.AutoFarmEnabled or StatsData.StartTime == 0 then
            updateStatsDisplay()
        end
    end)

    tokensAncestryConn = lbl.AncestryChanged:Connect(function(_, parent)
        if not parent or not lbl:IsDescendantOf(game) then
            if tokensChangedConn then
                tokensChangedConn:Disconnect()
                tokensChangedConn = nil
            end
            if tokensAncestryConn then
                tokensAncestryConn:Disconnect()
                tokensAncestryConn = nil
            end
            cachedTokensLabel = nil
        end
    end)
end

local function SetupInventoryTokensWatcher()
    task.spawn(function()
        local function tryHook(): boolean
            if cachedTokensLabel and cachedTokensLabel.Parent and cachedTokensLabel:IsDescendantOf(game) then
                return true
            end
            local lbl = FindInventoryTokensLabel()
            if lbl then
                HookInventoryTokensLabel(lbl)
                return true
            end
            return false
        end

        -- Первая попытка при старте
        tryHook()

        -- Опрос с нарастающей паузой:
        -- 1. Если ссылка уже есть и жива — моментально пропускает (0% CPU), пауза 5 с.
        -- 2. Если лейбл удалили/пересоздали (смена раунда) — тихо находит новую ссылку и вешает реактивный сигнал.
        -- 3. Если лейбла нет совсем (ивент закончился / путь изменился) — пауза растёт 5 → 10 → 20 → 30 с,
        --    чтобы не гонять рекурсивный поиск по PlayerGui каждые 5 секунд впустую.
        local delay = 5
        while not IsTerminated do
            task.wait(delay)
            if cachedTokensLabel and cachedTokensLabel.Parent and cachedTokensLabel:IsDescendantOf(game) then
                delay = 5
            elseif tryHook() then
                delay = 5
            else
                delay = math.min(delay * 2, 30)
            end
        end
    end)
end

SetupInventoryTokensWatcher()

