local function GetScreenAutoOptimalScale(): number
    local cam = Workspace.CurrentCamera
    local viewport = cam and cam.ViewportSize or Vector2.new(1920, 1080)
    local height = viewport.Y
    if height <= 0 then height = 1080 end
    
    if height < 600 then
        return UI_SCALE * 1.0  -- 0.5 (смартфоны / маленькие экраны)
    elseif height < 900 then
        return UI_SCALE * 1.4  -- 0.7 (ноутбуки / средние экраны)
    else
        return UI_SCALE * 1.8  -- 0.9 (Full HD 1080p / 2K мониторы)
    end
end

