local function IsFatalDisconnectMessage(msg: string?): boolean
    if typeof(msg) ~= "string" or msg == "" then return false end
    local lower = string.lower(msg)
    if string.find(lower, "kick", 1, true)
        or string.find(lower, "ban", 1, true)
        or string.find(lower, "moderator", 1, true)
        or string.find(lower, "same account", 1, true)
        or string.find(lower, "267", 1, true)
        or string.find(lower, "273", 1, true) then
        return true
    end
    return false
end

