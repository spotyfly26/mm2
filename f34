        end)
    end
end

local function RecordMapSizeIfNew(mapInstance: Instance)
    local function Cross2D(o: Vector2, a: Vector2, b: Vector2): number
        return (a.X - o.X) * (b.Y - o.Y) - (a.Y - o.Y) * (b.X - o.X)
    end
    
    -- Проекция точек Spawns на плоскость XZ -> выпуклая оболочка (без самопересечений) + площадь по формуле шнуровки
    local function CalculateMapArea(mapModel: Instance): number?
        local spawns = mapModel:FindFirstChild("Spawns")
        if not spawns then return nil end
    
        local sorted: { Vector2 } = {}
        local function addPart(part: BasePart)
            local p = part.Position
            if p.X == p.X and p.Z == p.Z then
                table.insert(sorted, Vector2.new(p.X, p.Z))
            end
        end
    
        if spawns:IsA("BasePart") then
            addPart(spawns)
        end
        for _, desc in ipairs(spawns:GetDescendants()) do
            if desc:IsA("BasePart") then
                addPart(desc)
            end
        end
    
        if #sorted < 3 then return nil end
    
        table.sort(sorted, function(a: Vector2, b: Vector2): boolean
            if a.X ~= b.X then return a.X < b.X end
            return a.Y < b.Y
        end)
    
        local unique: { Vector2 } = {}
        for _, p in ipairs(sorted) do
            local prev = unique[#unique]
            if not prev or math.abs(p.X - prev.X) > 1e-3 or math.abs(p.Y - prev.Y) > 1e-3 then
                table.insert(unique, p)
            end
        end
    
        if #unique < 3 then return nil end
    
        local lower: { Vector2 } = {}
        for _, p in ipairs(unique) do
            while #lower >= 2 and Cross2D(lower[#lower - 1], lower[#lower], p) <= 0 do
                table.remove(lower)
            end
            table.insert(lower, p)
        end
    
        local upper: { Vector2 } = {}
        for i = #unique, 1, -1 do
            local p = unique[i]
            while #upper >= 2 and Cross2D(upper[#upper - 1], upper[#upper], p) <= 0 do
                table.remove(upper)
            end
            table.insert(upper, p)
        end
    
        table.remove(lower)
        table.remove(upper)
        for _, p in ipairs(upper) do
            table.insert(lower, p)
        end
    
        local hullCount = #lower
        if hullCount < 3 then return nil end
    
        local sum = 0
        for i = 1, hullCount do
            local a = lower[i]
            local b = lower[(i % hullCount) + 1]
            sum = sum + (a.X * b.Y - b.X * a.Y)
        end
    
        local area = math.floor(math.abs(sum) * 0.5 + 0.5)
        return (area > 0) and area or nil
    end

    if IsTerminated or not mapInstance or not mapInstance.Parent then return end
    local rawName = mapInstance.Name
    if rawName == "" or rawName == "Workspace" or rawName == "Lobby" then return end

    local key = NormalizeMapKey(rawName)
    if key == "" or (MapSizesCache[key] and MapSizesCache[key] > 0) then
        return
    end

    task.spawn(function()
        local spawns = mapInstance:FindFirstChild("Spawns") or mapInstance:WaitForChild("Spawns", 10)
        if not spawns or IsTerminated or not mapInstance.Parent then return end

        -- Короткая пауза, чтобы все детали внутри Spawns гарантированно догрузились по сети
        task.wait(1)
        if IsTerminated or not mapInstance.Parent then return end
        if MapSizesCache[key] and MapSizesCache[key] > 0 then return end

        local area = CalculateMapArea(mapInstance)
        if area and area > 0 then
            SaveMapSize(rawName, area)
            print(string.format("[MM2 AIO] Новая карта '%s' замерена по Spawns XZ: %d кв. студов. Сохранено в %s", rawName, area, MAP_SIZES_FILE))
            UpdateStatus(string.format("База карт: '%s' = %d студов", rawName, area), Color3.fromRGB(100, 255, 150))
        end
    end)
end

