local cachedCleanTwin = string.lower(string.gsub(SETTINGS.TwinName or "", "^%s*(.-)%s*$", "%1"))

local function GetNearestCoin(isFirstCoin: boolean?): Instance?
    local char = rt:Character()
    if not char or not char.PrimaryPart then return nil end

    local myPos = char.PrimaryPart.Position

    -- Поиск позиции и вектора движения твинка (1 раз за вызов — 0.0001 мс, 0% CPU)
    local twinPos: Vector3? = nil
    local twinPredPos: Vector3? = nil
    local twinPlr: Player? = nil

    if SETTINGS.TwinAvoidEnabled and cachedCleanTwin ~= "" then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and string.lower(plr.Name) == cachedCleanTwin then
                if IsPlayerActuallyAlive(plr) then
                    local tChar = plr.Character
                    local tHrp = tChar and (tChar.PrimaryPart or tChar:FindFirstChild("HumanoidRootPart") or tChar:FindFirstChildWhichIsA("BasePart"))
                    if tHrp then
                        twinPos = tHrp.Position
                        twinPlr = plr
                        -- Векторное упреждение полета: определяем курс движения твинка на 1.5–2 сек вперед
                        local vel = tHrp.AssemblyLinearVelocity
                        if vel and vel.Magnitude > 3 then
                            twinPredPos = twinPos + (vel.Unit * math.min(vel.Magnitude * 1.8, 50))
                        end
                    end
                end
                break
            end
        end
    end

    -- На первой монете раунда разделяем стартовые позиции:
    -- Лидер берет ближний край, Ведомый телепортируется на противоположный (самый дальний) край карты
    local isLeader = true
    if twinPlr then
        isLeader = (string.lower(LocalPlayer.Name) < string.lower(twinPlr.Name))
    end

    local bestCoin = nil
    local bestDist = (isFirstCoin and not isLeader) and -1 or math.huge

    local fallbackCoin = nil
    local fallbackDist = math.huge

    local avoidRadius = SETTINGS.TwinAvoidRadius or 30

    for coin, _ in pairs(rt.cachedCoins) do
        if coin and coin.Parent and not isCoinTouched(coin) and coin:FindFirstChildWhichIsA("TouchTransmitter") then
            local coinPos = coin.Position
            local myDist = (coinPos - myPos).Magnitude

            -- Всегда сохраняем абсолютную ближайшую монету (fallback, если вся карта зачищена)
            if myDist < fallbackDist then
                fallbackDist = myDist
                fallbackCoin = coin
            end

            -- Стартовое разделение: ведомый ищет САМУЮ ДАЛЬНЮЮ монету от спавна
            if isFirstCoin and twinPlr and not isLeader then
                if myDist > bestDist then
                    bestDist = myDist
                    bestCoin = coin
                end
                continue
            end

            -- Проверка принадлежности монеты твинку (сокращенные радиусы + защита ближней зоны)
            local isTwinZone = false
            if twinPos then
                -- Если боты сблизились (< 25 студов друг от друга), уступаем монету по тай-брейкеру
                local botsDist = (myPos - twinPos).Magnitude
                local minSafeDist = (botsDist < 25) and 4 or 12

                if myDist > minSafeDist then
                    local twinDist = (coinPos - twinPos).Magnitude
                    local predDist = twinPredPos and (coinPos - twinPredPos).Magnitude or math.huge

                    -- 1) Монета в непосредственном радиусе твинка (30 студов)
                    -- 2) Монета на пути полета твинка (в радиусе 18 студов от вектора)
                    -- 3) Твинк строго ближе к этой монете, чем мы (диаграмма Вороного)
                    -- 4) При равном расстоянии тай-брейкер по имени
                    if (twinDist < avoidRadius)
                        or (predDist < 18)
                        or (twinDist < myDist)
                        or (twinDist == myDist and not isLeader) then
                        isTwinZone = true
                    end
                end
            end

            if not isTwinZone then
                if myDist < bestDist then
                    bestDist = myDist
                    bestCoin = coin
                end
            end
        else
            rt.cachedCoins[coin] = nil
        end
    end

    return bestCoin or fallbackCoin
end

local function BindClick(guiElement: GuiButton, callback: () -> ())
    local lastFire = 0
    local function fire()
        if IsTerminated then return end
        local now = os.clock()
        if now - lastFire < 0.25 then return end
        lastFire = now
        task.spawn(callback)
    end
    RegisterConnection(guiElement.Activated:Connect(fire))
    RegisterConnection(guiElement.MouseButton1Click:Connect(fire))
end

-- === УНИВЕРСАЛЬНЫЙ UI-ПАРСЕР СУМКИ (ТЕЛЕФОН / ПЛАНШЕТ / ПК) ===
local BagConnections: { [Instance]: { RBXScriptConnection } } = setmetatable({}, { __mode = "k" }) :: any

local function DisconnectBag(bagFrame: Instance)
    local conns = BagConnections[bagFrame]
    if conns then
        for _, c in ipairs(conns) do
            if c and c.Connected then pcall(function() c:Disconnect() end) end
        end
        BagConnections[bagFrame] = nil
    end
end

local function SetupBagParser()
    task.spawn(function()
        local playerGui = LocalPlayer:WaitForChild("PlayerGui", 15)
        if not playerGui then return end

        local hookedContainers: { [Instance]: boolean } = setmetatable({}, { __mode = "k" }) :: any
        local mainGuiDescConn: RBXScriptConnection? = nil

        -- Полная проверка реальной видимости на экране (по аналогии с votepads)
        local function isBagActuallyVisible(bagFrame: GuiObject, coinsLabel: TextLabel?): boolean
            if not bagFrame.Visible then return false end
            if coinsLabel and (not coinsLabel.Visible or coinsLabel.TextTransparency >= 1) then
                return false
            end
            if bagFrame.AbsoluteSize.X <= 0 or bagFrame.AbsoluteSize.Y <= 0 then
                return false
            end

            -- Проверка предков вплоть до ScreenGui
            local curr: Instance? = bagFrame.Parent
            while curr and curr:IsA("GuiObject") do
                if not (curr :: GuiObject).Visible then
                    return false
                end
                if curr:IsA("CanvasGroup") and (curr :: CanvasGroup).GroupTransparency >= 1 then
                    return false
                end
                curr = curr.Parent
            end
            return true
        end

        local function hookContainer(container: Instance)
            if not container or hookedContainers[container] then return end
            hookedContainers[container] = true

            local function bindToCurrencyBag(bagFrame: Instance)
                if not bagFrame:IsA("GuiObject") then return end

                local currencyFrame = bagFrame:FindFirstChild("CurrencyFrame") or bagFrame:WaitForChild("CurrencyFrame", 2)
                local icon = currencyFrame and (currencyFrame:FindFirstChild("Icon") or currencyFrame:WaitForChild("Icon", 2))
                local coinsLabel = icon and (icon:FindFirstChild("Coins") or icon:WaitForChild("Coins", 2)) :: TextLabel?

                -- coinsLabel — единственный строго обязательный элемент для подсчета монет
                if not coinsLabel or not coinsLabel:IsA("TextLabel") then return end

                -- Очищаем любые старые соединения для этого фрейма перед новой привязкой
                DisconnectBag(bagFrame)
                local bagConns: { RBXScriptConnection } = {}
                BagConnections[bagFrame] = bagConns

                -- Опциональные индикаторы заполненности (не блокируют привязку, если их нет)
                local fullLabel = bagFrame:FindFirstChild("Full") :: TextLabel?
                local fullBagIcon = bagFrame:FindFirstChild("FullBagIcon") :: ImageLabel?

                local lastCount = tonumber(coinsLabel.Text) or 0

                local function checkFull()
                    if not isBagActuallyVisible(bagFrame, coinsLabel) then return end
                    local count = tonumber(coinsLabel.Text) or 0
                    
                    if count < 40 then
                        BagIsFull = false
                        return
                    end

                    local isFull = false

                    if fullLabel and fullLabel.Visible and fullLabel.TextTransparency < 1 and fullLabel.Text == "Full!" then
                        isFull = true
                    end

                    if fullBagIcon and fullBagIcon:IsA("ImageLabel") and fullBagIcon.Visible and fullBagIcon.ImageTransparency < 1 then
                        isFull = true
                    end

                    local isEvent = (bagFrame.Name ~= "Coin")
                    local maxLimit = isEvent and 50 or (rt:IsElite() and 50 or 40)

                    if count >= maxLimit then
                        isFull = true
                    end

                    BagIsFull = isFull
                end

                -- Реактивное обновление при изменении текста количества монет
                table.insert(bagConns, coinsLabel:GetPropertyChangedSignal("Text"):Connect(function()
                    if IsTerminated then return end
                    if not isBagActuallyVisible(bagFrame, coinsLabel) then return end

                    local currentCount = tonumber(coinsLabel.Text) or 0
                    if currentCount > lastCount then
                        local gained = currentCount - lastCount
                        StatsData.CoinsCollected = StatsData.CoinsCollected + gained
                        BagCoinCount = currentCount
                        ActiveCurrencyName = bagFrame.Name
                    elseif currentCount < lastCount then
                        BagCoinCount = currentCount
                    end

                    lastCount = currentCount
                    checkFull()
                end))

                -- Проверка при изменении видимости самого фрейма
                table.insert(bagConns, bagFrame:GetPropertyChangedSignal("Visible"):Connect(function()
                    if IsTerminated then return end
                    if RoundInProgress() and isBagActuallyVisible(bagFrame, coinsLabel) then
                        ActiveCurrencyName = bagFrame.Name
                        BagCoinCount = tonumber(coinsLabel.Text) or 0
                        checkFull()
                    end
                end))

                -- Проверка при изменении видимости всех предков с изоляцией в bagConns (отключаются вместе с сумкой)
                local currParent: Instance? = bagFrame.Parent
                while currParent and currParent:IsA("GuiObject") do
                    local pObj = currParent :: GuiObject
                    table.insert(bagConns, pObj:GetPropertyChangedSignal("Visible"):Connect(function()
                        if IsTerminated then return end
                        if RoundInProgress() and isBagActuallyVisible(bagFrame, coinsLabel) then
                            ActiveCurrencyName = bagFrame.Name
                            BagCoinCount = tonumber(coinsLabel.Text) or 0
                            checkFull()
                        end
                    end))
                    currParent = currParent.Parent
                end

                if fullLabel then
                    table.insert(bagConns, fullLabel:GetPropertyChangedSignal("Visible"):Connect(function()
                        if IsTerminated then return end
                        checkFull()
                    end))

                    table.insert(bagConns, fullLabel:GetPropertyChangedSignal("Text"):Connect(function()
                        if IsTerminated then return end
                        checkFull()
                    end))

                    table.insert(bagConns, fullLabel:GetPropertyChangedSignal("TextTransparency"):Connect(function()
                        if IsTerminated then return end
                        checkFull()
                    end))
                end

                if fullBagIcon then
                    table.insert(bagConns, fullBagIcon:GetPropertyChangedSignal("Visible"):Connect(function()
                        if IsTerminated then return end
                        checkFull()
                    end))

                    table.insert(bagConns, fullBagIcon:GetPropertyChangedSignal("ImageTransparency"):Connect(function()
                        if IsTerminated then return end
                        checkFull()
                    end))
                end

                -- Автоматическое отключение и очистка при удалении фрейма сумки
                table.insert(bagConns, bagFrame.AncestryChanged:Connect(function(_, parent)
                    if not parent or not bagFrame:IsDescendantOf(game) then
                        DisconnectBag(bagFrame)
                    end
                end))

                -- Начальная инициализация при старте
                if RoundInProgress() and isBagActuallyVisible(bagFrame, coinsLabel) then
                    ActiveCurrencyName = bagFrame.Name
                    BagCoinCount = tonumber(coinsLabel.Text) or 0
                    checkFull()
                end
            end

            for _, bag in ipairs(container:GetChildren()) do
                bindToCurrencyBag(bag)
            end

            local containerAddConn: RBXScriptConnection? = nil
            local containerRemConn: RBXScriptConnection? = nil
            local containerAncConn: RBXScriptConnection? = nil

            local function disconnectContainer()
                hookedContainers[container] = nil
                if containerAddConn then
                    if containerAddConn.Connected then pcall(function() (containerAddConn :: RBXScriptConnection):Disconnect() end) end
                    containerAddConn = nil
                end
                if containerRemConn then
                    if containerRemConn.Connected then pcall(function() (containerRemConn :: RBXScriptConnection):Disconnect() end) end
                    containerRemConn = nil
                end
                if containerAncConn then
                    if containerAncConn.Connected then pcall(function() (containerAncConn :: RBXScriptConnection):Disconnect() end) end
                    containerAncConn = nil
                end
                for _, child in ipairs(container:GetChildren()) do
                    DisconnectBag(child)
                end
                PruneActiveConnections()
            end

            containerAddConn = container.ChildAdded:Connect(function(child)
                if IsTerminated then return end
                bindToCurrencyBag(child)
            end)
            if containerAddConn then RegisterConnection(containerAddConn) end

            containerRemConn = container.ChildRemoved:Connect(function(child)
                DisconnectBag(child)
            end)
            if containerRemConn then RegisterConnection(containerRemConn) end

            containerAncConn = container.AncestryChanged:Connect(function(_, parent)
                if not parent or not container:IsDescendantOf(game) then
                    disconnectContainer()
                end
            end)
            if containerAncConn then RegisterConnection(containerAncConn) end
        end

        local function scanAndHookContainers(mainGui: Instance)
            if mainGui.Name ~= "MainGUI" then return end

            -- 1. Режим Планшета / ПК / Игры: MainGUI.Game.CoinBags.Container
            local gameObj = mainGui:FindFirstChild("Game")
            local gameBags = gameObj and gameObj:FindFirstChild("CoinBags")
            local gameContainer = gameBags and gameBags:FindFirstChild("Container")
            if gameContainer then
                hookContainer(gameContainer)
            end

            -- 2. Режим Телефона: MainGUI.Lobby.Dock.CoinBags.Container
            local lobby = mainGui:FindFirstChild("Lobby")
            local dock = lobby and lobby:FindFirstChild("Dock")
            local dockBags = dock and dock:FindFirstChild("CoinBags")
            local dockContainer = dockBags and dockBags:FindFirstChild("Container")
            if dockContainer then
                hookContainer(dockContainer)
            end

            -- 3. Резервный моментальный поиск в глубину (если путь нестандартный)
            if not gameContainer and not dockContainer then
                local anyBags = mainGui:FindFirstChild("CoinBags", true)
                local anyContainer = anyBags and anyBags:FindFirstChild("Container")
                if anyContainer then
                    hookContainer(anyContainer)
                end
            end

            -- 4. Реактивный перехват динамического появления Container с защитой от накопления слушателей
            if mainGuiDescConn then
                mainGuiDescConn:Disconnect()
                mainGuiDescConn = nil
                PruneActiveConnections()
            end
            mainGuiDescConn = mainGui.DescendantAdded:Connect(function(desc)
                if IsTerminated then return end
                if desc.Name == "Container" and desc.Parent and desc.Parent.Name == "CoinBags" then
                    hookContainer(desc)
                end
            end)
            if mainGuiDescConn then RegisterConnection(mainGuiDescConn) end
        end

        local existingMain = playerGui:FindFirstChild("MainGUI")
        if existingMain then
            task.spawn(scanAndHookContainers, existingMain)
        end

        RegisterConnection(playerGui.ChildAdded:Connect(function(child)
            if child.Name == "MainGUI" then
                task.spawn(scanAndHookContainers, child)
            end
        end))
    end)
end

SetupBagParser()

