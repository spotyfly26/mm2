local function EnsureConfigFolder(): boolean
    local mf = makefolder or (syn and syn.makefolder)
    local isfld = isfolder or (syn and syn.isfolder)
    if typeof(mf) == "function" then
        if typeof(isfld) == "function" then
            local ok, exists = pcall(isfld, CONFIG_FOLDER)
            if ok and exists then return true end
        end
        local ok = pcall(mf, CONFIG_FOLDER)
        return ok
    end
    return false
end

local function NormalizeMapKey(name: string): string
    local lower = string.lower(name)
    lower = string.gsub(lower, "'s(%A)", "%1")
    lower = string.gsub(lower, "'s$", "")
    lower = string.gsub(lower, "’s(%A)", "%1")
    lower = string.gsub(lower, "’s$", "")
    return (string.gsub(lower, "[^%w]", ""))
end

local function LoadMapSizes(): { [string]: number }
    local rf = readfile or (syn and syn.readfile)
    local isf = isfile or (syn and syn.isfile)
    if typeof(isf) == "function" and typeof(rf) == "function" then
        local targetFile: string? = nil
        for _, candidate in ipairs({ MAP_SIZES_FILE, LEGACY_MAP_SIZES_FILE }) do
            local ok, exists = pcall(isf, candidate)
            if ok and exists then
                targetFile = candidate
                break
            end
        end

        if targetFile then
            local readOk, content = pcall(rf, targetFile)
            if readOk and typeof(content) == "string" and content ~= "" then
                local decodeOk, data = pcall(function()
                    return HttpService:JSONDecode(content)
                end)
                -- Загружаем только базу, посчитанную по Spawns XZ (игнорируя старый кэш с GetBoundingBox)
                if decodeOk and typeof(data) == "table" and data[SPAWNS_SCHEMA_KEY] == 1 then
                    local cleanData: { [string]: number } = {}
                    for k, v in pairs(data) do
                        if typeof(k) == "string" and k ~= SPAWNS_SCHEMA_KEY and typeof(v) == "number" and v == v and v > 0 then
                            local normKey = NormalizeMapKey(k)
                            if normKey ~= "" then
                                cleanData[normKey] = math.floor(v + 0.5)
                            end
                        end
                    end
                    return cleanData
                end
            end
        end
    end
    return {}
end

