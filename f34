local function DismissDeviceSelect(devSelectGui: Instance)
    if IsTerminated then return end
    print("[MM2 AIO] Обнаружен экран выбора устройства (DeviceSelect). Запуск цикла автовыбора Tablet...")
    UpdateStatus("Выбор устройства: Tablet...", Color3.fromRGB(120, 200, 255))
    
    -- 1. Сетевой вызов (моментально регистрирует выбор на сервере MM2)
    local changeDevRemote = FindRemoteEvent("ChangeLastDevice")
    if changeDevRemote then
        pcall(function()
            changeDevRemote:FireServer("Tablet")
        end)
    end

    -- 2. Клиентская активация кнопки Tablet.Button (пульс до подтверждения игрой)
    task.spawn(function()
        local startTime = os.clock()
        local fs = firesignal or (syn and syn.firesignal)
        local gc = getconnections or (syn and syn.getconnections)
        local vim = game:GetService("VirtualInputManager")

        while not IsTerminated and devSelectGui and devSelectGui.Parent and (os.clock() - startTime < 10) do
            local container = devSelectGui:FindFirstChild("Container")
            local tablet = container and container:FindFirstChild("Tablet")
            local btn = tablet and tablet:FindFirstChild("Button")

            if btn and btn:IsA("GuiButton") then
                if typeof(fs) == "function" then
                    pcall(function() fs(btn.MouseButton1Click) end)
                    pcall(function() fs(btn.Activated) end)
                end

                if typeof(gc) == "function" then
                    for _, evName in ipairs({"MouseButton1Click", "Activated"}) do
                        local sOk, sig = pcall(function() return (btn :: any)[evName] end)
                        if sOk and sig then
                            local cOk, conns = pcall(gc, sig)
                            if cOk and typeof(conns) == "table" and #conns > 0 then
                                for _, c in ipairs(conns) do
                                    pcall(function() c:Fire() end)
                                end
                            end
                        end
                    end
                end

                if btn:IsA("GuiObject") and btn.AbsoluteSize.X > 0 then
                    pcall(function()
                        local absPos = btn.AbsolutePosition
                        local absSize = btn.AbsoluteSize
                        local cx = absPos.X + absSize.X / 2
                        local cy = absPos.Y + absSize.Y / 2
                        vim:SendMouseButtonEvent(cx, cy, 0, true, game, 0)
                        task.wait(0.03)
                        vim:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
                    end)
                end
            end
            task.wait(0.2)
        end
    end)
end

local function DismissJoinPrompt(joinGui: Instance)
