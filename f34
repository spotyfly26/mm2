-- === ПОЛНОЕ ЗАКРЫТИЕ И ВЫГРУЗКА СКРИПТА ===
local function TerminateScript()
    if IsTerminated then return end
    IsTerminated = true
    
    SETTINGS.AutoFarmEnabled = false
    SETTINGS.AutoVoteEnabled = false
    SETTINGS.AutoRejoinEnabled = false
    RejoinPending = false
    isVotingNoclip = false
    safeNoclipUntil = 0
    ResetSafeZoneState()
    UnequipKnife()
    DisconnectCharDescConn()
    
    for _, conn in ipairs(ActiveConnections) do
        if conn and conn.Connected then
            pcall(function() conn:Disconnect() end)
        end
    end
    table.clear(ActiveConnections)

    for child, _ in pairs(candidateConnections) do
        DisconnectCandidate(child)
    end
    table.clear(candidateConnections)
    
    for _, conn in pairs(rt.potatoConnections) do
        if conn and conn.Connected then
            pcall(function() conn:Disconnect() end)
        end
    end
    table.clear(rt.potatoConnections)
    
    if dragEndConn then
        pcall(function() dragEndConn:Disconnect() end)
        dragEndConn = nil
    end

    for bag, conns in pairs(BagConnections) do
        for _, c in ipairs(conns) do
            if c and c.Connected then pcall(function() c:Disconnect() end) end
        end
    end
    table.clear(BagConnections)

    table.clear(rt.cachedBodyParts)
    AutoFarmCleanUp()

    if tokensChangedConn then
        pcall(function() tokensChangedConn:Disconnect() end)
        tokensChangedConn = nil
    end
    if tokensAncestryConn then
        pcall(function() tokensAncestryConn:Disconnect() end)
        tokensAncestryConn = nil
    end
    cachedTokensLabel = nil
    
    pcall(function()
        local char = LocalPlayer.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
            local hum = char:FindFirstChildOfClass("Humanoid")
            
            if hum then
                hum.PlatformStand = false
            end
            
            if hrp then
                local bv = hrp:FindFirstChild("FarmVelocity")
                if bv then bv:Destroy() end
                
                local bg = hrp:FindFirstChild("FarmGyro")
                if bg then bg:Destroy() end

                local vh = hrp:FindFirstChild("VoteHover")
                if vh then vh:Destroy() end

                local vg = hrp:FindFirstChild("VoteGyro")
                if vg then vg:Destroy() end
                
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end
            
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    part.CanCollide = true
                end
            end
        end
    end)
    
    pcall(function()
        setTargetFps(60)
        StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, true)
        RunService:Set3dRenderingEnabled(true)
        RestoreLighting()
    end)
    
    if SessionMarker and SessionMarker.Parent then
        SessionMarker:Destroy()
    end
    if ScreenGui and ScreenGui.Parent then
        ScreenGui:Destroy()
    end
    if typeof(SharedEnv) == "table" and SharedEnv.MM2_AIO_Terminate == TerminateScript then
        SharedEnv.MM2_AIO_Terminate = nil
    end
    
    print("[MM2 AIO] Скрипт полностью остановлен и выгружен.")
end

if typeof(SharedEnv) == "table" then
    SharedEnv.MM2_AIO_Terminate = TerminateScript
end

BindClick(CloseBtn, TerminateScript)
