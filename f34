    { text = "1.5x", scale = UI_SCALE * 1.5, isAuto = false, color = Color3.fromRGB(40, 90, 180) },
    { text = "2x", scale = UI_SCALE * 2.0, isAuto = false, color = Color3.fromRGB(45, 125, 245) }
}
local scaleIndex = SETTINGS.ScaleIndex or 1
local initialScaleStep = scaleSteps[scaleIndex] or scaleSteps[1]

local function ApplyCurrentScale(recenter: boolean?)
    local current = scaleSteps[scaleIndex] or scaleSteps[1]
    if current.isAuto then
        MainScale.Scale = GetScreenAutoOptimalScale()
    else
        MainScale.Scale = current.scale or (UI_SCALE * 1.0)
    end
    if recenter then
        MainFrame.Position = UDim2.new(0.5, 0, 0.55, 0)
    end
end

