local function ClampNumber(val: any, minVal: number, maxVal: number, defaultVal: number): number
    if typeof(val) ~= "number" or val ~= val then
        return defaultVal
    end
    return math.clamp(math.floor(val + 0.5), minVal, maxVal)
end

local function SanitizeTwinName(val: any): string
    if typeof(val) ~= "string" then return "" end
    local trimmed = string.gsub(val, "^%s*(.-)%s*$", "%1")
    if #trimmed > 25 then
        trimmed = string.sub(trimmed, 1, 25)
    end
    return trimmed
end

local function LoadProfile(): { [string]: any }?
