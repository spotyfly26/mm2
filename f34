-- Ядро выполнения реконнекта
DoRejoin = function(reason: string?, isManual: boolean?)
    if isTeleporting or IsTerminated then return end
    if not isManual and not SETTINGS.AutoRejoinEnabled then return end
    if not isManual and rejoinAttempts >= MAX_REJOIN_ATTEMPTS then
        warn("[AutoRejoin] Превышен лимит попыток реконнекта (" .. tostring(MAX_REJOIN_ATTEMPTS) .. "). Остановка.")
        UpdateStatus("Реконнект: лимит попыток исчерпан", Color3.fromRGB(255, 80, 80))
        return
    end

    isTeleporting = true
    rejoinAttempts = rejoinAttempts + 1

    local targetReason = reason or "Таймер"
    print(string.format("[AutoRejoin] Запуск реконнекта (%s, попытка %d/%d)...", targetReason, rejoinAttempts, MAX_REJOIN_ATTEMPTS))
    UpdateStatus(string.format("Реконнект (%s, #%d)...", targetReason, rejoinAttempts), Color3.fromRGB(255, 200, 100))

    pcall(function()
        GuiService:ClearError()
    end)
    
    local success = false
    if SETTINGS.RejoinServerMode == "Same" and typeof(game.JobId) == "string" and game.JobId ~= "" then
        UpdateStatus("Переход на текущий сервер (JobId)...", Color3.fromRGB(150, 200, 255))
        local ok, err = pcall(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
        end)
        if ok then
            success = true
        else
            warn("[AutoRejoin] Не удалось отправить запрос на тот же сервер: " .. tostring(err))
        end
    end
    
    if not success then
        UpdateStatus("Переход на случайный сервер...", Color3.fromRGB(150, 200, 255))
        pcall(function()
            TeleportService:Teleport(game.PlaceId, LocalPlayer)
        end)
    end
    
    local backoff = math.min(5 * (2 ^ (rejoinAttempts - 1)), 60)
    task.delay(backoff, function()
        isTeleporting = false
    end)
end

-- Обработка сбоя телепорта (сервер выключен, полон или недоступен)
RegisterConnection(TeleportService.TeleportInitFailed:Connect(function(player, teleportResult, errorMessage)
    if IsTerminated or player ~= LocalPlayer then return end
    if not isTeleporting and not SETTINGS.AutoRejoinEnabled then return end
    if IsFatalDisconnectMessage(errorMessage) then
        isTeleporting = false
        UpdateStatus("Реконнект отменен: фатальная ошибка", Color3.fromRGB(255, 80, 80))
        return
    end
    if rejoinAttempts >= MAX_REJOIN_ATTEMPTS then
        isTeleporting = false
        warn("[AutoRejoin] Достигнут лимит попыток после сбоя телепорта.")
        UpdateStatus("Реконнект: лимит попыток исчерпан", Color3.fromRGB(255, 80, 80))
        return
    end

    rejoinAttempts = rejoinAttempts + 1
    local waitSec = math.min(2 * (2 ^ (rejoinAttempts - 1)), 30)
    warn(string.format("[AutoRejoin] Ошибка инициализации телепорта: %s (%s). Повтор #%d через %d с...", tostring(errorMessage), tostring(teleportResult), rejoinAttempts, waitSec))
    UpdateStatus(string.format("Ошибка перехода. Повтор #%d через %dс...", rejoinAttempts, waitSec), Color3.fromRGB(255, 100, 100))
    task.wait(waitSec)
    if IsTerminated then return end
    pcall(function()
        GuiService:ClearError()
    end)
    pcall(function()
        TeleportService:Teleport(game.PlaceId, LocalPlayer)
    end)
    isTeleporting = false
end))

