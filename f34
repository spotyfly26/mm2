-- Вспомогательная быстрая проверка видимости сумки игрока (fallback при старте скрипта посреди раунда)
local cachedBagContainer: Instance? = nil -- кэш контейнера сумки: путь ищем один раз, а не при каждом вызове

local function CheckBagGuiVisible(): boolean
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return false end
    local mainGui = playerGui:FindFirstChild("MainGUI")
    if not mainGui or not mainGui:IsA("ScreenGui") or not mainGui.Enabled then return false end

    local bagContainer = cachedBagContainer
    if not bagContainer or not bagContainer:IsDescendantOf(mainGui) then
        local gameObj = mainGui:FindFirstChild("Game")
        local gameBags = gameObj and gameObj:FindFirstChild("CoinBags")
        local dock = mainGui:FindFirstChild("Lobby") and mainGui.Lobby:FindFirstChild("Dock")
        local dockBags = dock and dock:FindFirstChild("CoinBags")

        bagContainer = (gameBags and gameBags:FindFirstChild("Container")) or (dockBags and dockBags:FindFirstChild("Container"))
        if not bagContainer then
            local anyBags = mainGui:FindFirstChild("CoinBags", true)
            bagContainer = anyBags and anyBags:FindFirstChild("Container")
        end
        cachedBagContainer = bagContainer
    end

    if not bagContainer or not bagContainer:IsA("GuiObject") or not bagContainer.Visible then
        return false
    end

    -- Проверяем предков контейнера
    local curr: Instance? = bagContainer.Parent
    while curr and curr:IsA("GuiObject") do
        if not curr.Visible then return false end
        if curr:IsA("CanvasGroup") and curr.GroupTransparency >= 1 then return false end
        curr = curr.Parent
    end

    if bagContainer.AbsoluteSize.X <= 0 or bagContainer.AbsoluteSize.Y <= 0 then
        return false
    end

    -- Строгая проверка: ищем реально активную сумку с видимым текстом баланса монет (Coins)
    for _, bag in ipairs(bagContainer:GetChildren()) do
        if bag:IsA("GuiObject") and bag.Visible and bag.AbsoluteSize.X > 0 and bag.AbsoluteSize.Y > 0 then
            local currFrame = bag:FindFirstChild("CurrencyFrame")
            local icon = currFrame and currFrame:FindFirstChild("Icon")
            local coinsLabel = icon and icon:FindFirstChild("Coins")
            if coinsLabel and coinsLabel:IsA("TextLabel") and coinsLabel.Visible and coinsLabel.TextTransparency < 1 then
                return true
            end
        end
    end

    return false
end

function rt:CheckIfPlayerWasInARound(): boolean
    if not rt:Map() then return false end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end

    -- 1. Проверка серверного статуса Dead (атрибут Dead или сетевой кэш PlayerAliveCache):
    local deadStatus = GetPlayerDeadStatus(LocalPlayer)
    if deadStatus == true then
        -- true = мёртв / не в раунде в любом случае
        return false
    elseif deadStatus == false then
        -- false = в раунде и полноценно жив
        return true
    end

    -- 2. Если deadStatus == nil (таблица ещё не обновилась или в лобби):
    -- Если мы УЖЕ находимся в активной фазе раунда (State.Action) — раунд идёт,
    -- персонаж жив и карта существует: исключаем любые ложные сбросы
    if CurrentState == State.Action then
        return true
    end

    -- Проверка наличия роли (Infection: Survivor/Infected, Classic: Innocent/Sheriff/Murderer и др.)
    if HasAssignedRole() then
        PlayerAliveCache[LocalPlayer.Name] = false
        return true
    end

    -- Проверка физического переноса персонажа на карту (> 100 студов от точки лобби)
    if LastKnownLobbyPosition then
        local hrp = char.PrimaryPart or char:FindFirstChild("HumanoidRootPart") :: BasePart?
        if hrp and (hrp.Position - LastKnownLobbyPosition).Magnitude > 100 then
            PlayerAliveCache[LocalPlayer.Name] = false
            return true
        end
    end

    -- Резервная проверка через спавны карты
    local spawnPos = GetMapSpawnPosition()
    if spawnPos then
        local hrp = char.PrimaryPart or char:FindFirstChild("HumanoidRootPart") :: BasePart?
        if hrp and (hrp.Position - spawnPos).Magnitude < 300 then
            PlayerAliveCache[LocalPlayer.Name] = false
            return true
        end
    end

    -- nil -> Ремоуты ещё не стреляли. Fallback через видимость сумки на экране.
    if CheckBagGuiVisible() then
        PlayerAliveCache[LocalPlayer.Name] = false
        return true
    end

    return false
end

function rt:IsElite(): boolean
    return self.player:GetAttribute("Elite") == true
end

