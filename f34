-- СИСТЕМА УЧЕТА КАРТЫ И МОНЕТ В WORKSPACE (ИЗ 44.LUA)
-- =====================================================================
local CurrentMapInstance: Instance? = nil
local CurrentMapSpawnPosition: Vector3? = nil
local CurrentMapSafeY: number? = nil -- Высота сейф-зоны, вычисленная по карте в RegisterMap
local CurrentMapCcConn: RBXScriptConnection? = nil
local CurrentMapRemConn: RBXScriptConnection? = nil
local candidateConnections: { [Instance]: { RBXScriptConnection } } = setmetatable({}, { __mode = "k" }) :: any

local function DisconnectCurrentMapListeners()
    if CurrentMapCcConn then
        if CurrentMapCcConn.Connected then pcall(function() (CurrentMapCcConn :: RBXScriptConnection):Disconnect() end) end
        CurrentMapCcConn = nil
    end
    if CurrentMapRemConn then
        if CurrentMapRemConn.Connected then pcall(function() (CurrentMapRemConn :: RBXScriptConnection):Disconnect() end) end
        CurrentMapRemConn = nil
    end
end

-- Состояние safe-телепорта (одноразовый за раунд)
local LastKnownLobbyPosition: Vector3? = nil
local safeZoneTaskRunning = false
local safeZoneDone = false -- true после первой попытки в этом раунде: повторно сейф-зона не запускается
local safeZoneGen = 0 -- поколение: устаревший поток не трогает флаги нового раунда

local function ResetSafeZoneState()
    safeZoneGen = safeZoneGen + 1
    safeZoneTaskRunning = false
    safeZoneDone = false
    LastKnownLobbyPosition = nil
end

local function DisconnectCandidate(child: Instance)
    local conns = candidateConnections[child]
    if conns then
        for _, c in ipairs(conns) do
            if c and c.Connected then pcall(function() c:Disconnect() end) end
        end
        candidateConnections[child] = nil
    end
end

local function IsMapCandidate(child: Instance): boolean
    if not child:IsA("Model") and not child:IsA("Folder") then return false end
    if child == LocalPlayer.Character or (child:IsA("Model") and Players:GetPlayerFromCharacter(child)) then return false end
    if child:FindFirstChildOfClass("Humanoid") then return false end
    if child.Name == "Lobby" or child.Name == "Terrain" or child.Name == "Camera" then return false end
    if child.Name == "RaycastFilter" or child.Name == "GunDrop" or child.Name == "Raggy" or child.Name == "KnifeHost" then return false end
    return true
end

local function CleanupMap(child: Instance)
    DisconnectCandidate(child)
    if CurrentMapInstance == child then
        DisconnectCurrentMapListeners()
        CurrentMapInstance = nil
        CurrentMapSpawnPosition = nil
        CurrentMapSafeY = nil
        ResetSafeZoneState()
        rt.coinContainer = nil
        AutoFarmCleanUp()
    else
        PruneActiveConnections()
    end
end

local function GetMapSpawnPosition(): Vector3?
    if CurrentMapSpawnPosition then return CurrentMapSpawnPosition end
    if not CurrentMapInstance or CurrentMapInstance.Parent ~= Workspace then return nil end
    local spawns = CurrentMapInstance:FindFirstChild("Spawns")
    if spawns then
        local p = spawns:FindFirstChildWhichIsA("BasePart", true)
        if p then
            CurrentMapSpawnPosition = p.Position
            return p.Position
        end
    end
    if CurrentMapInstance:IsA("Model") then
        local ok, cf = pcall(function() return (CurrentMapInstance :: Model):GetPivot() end)
        if ok and cf then
            CurrentMapSpawnPosition = cf.Position
            return cf.Position
        end
    end
    return nil
end

-- === ВЫЧИСЛЕНИЕ ВЫСОТЫ SAFE-ЗОНЫ ПО КАРТЕ (один раз при RegisterMap) ===
-- Safe-зона = под самой нижней точкой карты (минус SafeZoneMargin). Монеты на этот момент ещё не заспавнены,
-- поэтому ориентируемся только на саму карту. SafeUnderfloorY остаётся запасным значением.
local function ComputeMapSafeY(map: Instance): number?
    local minY: number? = nil

    if map:IsA("Model") then
        local ok, cf, size = pcall(function() return (map :: Model):GetBoundingBox() end)
        if ok and cf and size then
            minY = cf.Position.Y - size.Y / 2
        end
    else
        -- Folder: у него нет GetBoundingBox, обходим части один раз (с паузами, чтобы не подвесить клиент)
        local n = 0
        for _, d in ipairs(map:GetDescendants()) do
            if d:IsA("BasePart") then
                local y = d.Position.Y - d.Size.Y / 2
                if not minY or y < minY then minY = y end
            end
            n = n + 1
            if n % 400 == 0 then task.wait() end
        end
    end

    if not minY then return nil end

    -- Защита от выбросов (например, огромная деталь далеко внизу): не глубже 300 студов от спавна
    -- и не ниже порога уничтожения упавших деталей
    local spawnY = (CurrentMapSpawnPosition and CurrentMapSpawnPosition.Y) or minY
    local y = minY - (SETTINGS.SafeZoneMargin or 15)
    y = math.max(y, spawnY - 300)
    y = math.max(y, Workspace.FallenPartsDestroyHeight + 50)
    return y
end

-- === МЕХАНИКА SAFE ТЕЛЕПОРТА (ОДНОРАЗОВО ЗА РАУНД, ЗАПУСК ИЗ RegisterMap) ===
-- Порядок в MM2: карта загружена (RegisterMap) -> через несколько секунд игроков телепортирует на карту ->
-- роли/таргеты и отсчёт ~10 с -> спавн монет и выдача оружия.
-- Задача: сразу после ТП на карту спрятаться под карту, чтобы к спавну монет/оружия к нам не подошли.
-- Повторный запуск в том же раунде запрещён (safeZoneDone), иначе ТП к первой монете принимается
-- за "ТП на карту" и возвращает нас обратно в сейф-зону.
local function StartSafeZoneWatch()
    if safeZoneTaskRunning or safeZoneDone or IsTerminated or not SETTINGS.AutoFarmEnabled then return end
    safeZoneTaskRunning = true
    local gen = safeZoneGen

    task.spawn(function()
        local lobbyPos: Vector3? = nil
        local detected = false
        local watchStart = os.clock()

        -- Опрос 20 раз/с (без Changed-сигналов на физике): первая точка = позиция в лобби на момент загрузки карты
        while not IsTerminated and SETTINGS.AutoFarmEnabled and gen == safeZoneGen and (os.clock() - watchStart < 25) do
            local c = LocalPlayer.Character
            local h = c and (c.PrimaryPart or c:FindFirstChild("HumanoidRootPart") :: BasePart?)
            local hum = c and c:FindFirstChildOfClass("Humanoid")

            if h and hum and hum.Health > 0 then
                if not lobbyPos then
                    lobbyPos = h.Position
                    LastKnownLobbyPosition = lobbyPos
                elseif (h.Position - lobbyPos).Magnitude > 100 then
                    detected = true
                    break
                end
            end
            task.wait(0.05)
        end

        if detected and not IsTerminated and SETTINGS.AutoFarmEnabled and gen == safeZoneGen then
            UpdateStatus("Сейф-зона: ТП на карту обнаружен, пауза (0.3с)...", Color3.fromRGB(130, 200, 255))
            task.wait(0.3)

            local c = LocalPlayer.Character
            local h = c and (c.PrimaryPart or c:FindFirstChild("HumanoidRootPart") :: BasePart?)
            local hum = c and c:FindFirstChildOfClass("Humanoid")

            if c and h and hum and hum.Health > 0 and not IsTerminated and SETTINGS.AutoFarmEnabled and gen == safeZoneGen then
                -- Гарантированный ноклип на время перехода (дальше его держит State.Action)
                safeNoclipUntil = os.clock() + 2
                updateBodyPartsCache()
                for _, part in ipairs(rt.cachedBodyParts) do
                    if part and part.Parent then
                        part.CanCollide = false
                    end
                end

                local safeY = CurrentMapSafeY or SETTINGS.SafeUnderfloorY or 200
                local safePos = Vector3.new(h.Position.X, safeY, h.Position.Z)

                hum.PlatformStand = true

                local bv = h:FindFirstChild("FarmVelocity") or Instance.new("BodyVelocity")
                bv.Name = "FarmVelocity"
                bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                bv.Velocity = Vector3.zero
                bv.Parent = h

                local bg = h:FindFirstChild("FarmGyro") or Instance.new("BodyGyro")
                bg.Name = "FarmGyro"
                bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
                bg.CFrame = CFrame.new(safePos)
                bg.P = 3000
                bg.Parent = h

                h.AssemblyLinearVelocity = Vector3.zero
                h.AssemblyAngularVelocity = Vector3.zero
                c:PivotTo(CFrame.new(safePos))

                UpdateStatus("Сейф-зона: Персонаж укрыт под картой", Color3.fromRGB(120, 255, 120))
            end
        end

        -- Одна попытка за раунд (успех, таймаут или отключённый фарм — не важно): повторно не армируем
        if gen == safeZoneGen then
            safeZoneDone = true
            safeZoneTaskRunning = false
        end
    end)
end

local function RegisterMap(child: Instance, spawns: Instance?, container: Instance?)
    if CurrentMapInstance == child then return end
    DisconnectCurrentMapListeners()
    CurrentMapInstance = child
    DisconnectCandidate(child)
    PruneActiveConnections()

    CurrentMapSpawnPosition = nil
    local s = spawns or child:FindFirstChild("Spawns")
    if s then
        local p = s:FindFirstChildWhichIsA("BasePart", true)
        if p then CurrentMapSpawnPosition = p.Position end
    end
    if not CurrentMapSpawnPosition and child:IsA("Model") then
        local ok, cf = pcall(function() return child:GetPivot() end)
        if ok and cf then CurrentMapSpawnPosition = cf.Position end
    end

    local ccConn: RBXScriptConnection? = nil
    if container then
        rt.coinContainer = container
        if CurrentState == State.Action and SETTINGS.AutoFarmEnabled then
            PopulateCoins()
        end
    else
        ccConn = child.ChildAdded:Connect(function(newChild)
            if newChild.Name == "CoinContainer" then
                if CurrentMapCcConn == ccConn then CurrentMapCcConn = nil end
                if ccConn then ccConn:Disconnect(); ccConn = nil end
                rt.coinContainer = newChild
                if CurrentState == State.Action and SETTINGS.AutoFarmEnabled then
                    PopulateCoins()
                end
            end
        end)
        CurrentMapCcConn = ccConn
        if ccConn then RegisterConnection(ccConn) end

        task.spawn(function()
            local cc = child:WaitForChild("CoinContainer", 15)
            if cc and not rt.coinContainer and CurrentMapInstance == child then
                if CurrentMapCcConn == ccConn then CurrentMapCcConn = nil end
                if ccConn then ccConn:Disconnect(); ccConn = nil end
                rt.coinContainer = cc
                if CurrentState == State.Action and SETTINGS.AutoFarmEnabled then
                    PopulateCoins()
                end
            end
        end)
    end

    local remConn: RBXScriptConnection? = nil
    remConn = child.AncestryChanged:Connect(function(_, parent)
        if not parent or parent ~= Workspace then
            if CurrentMapRemConn == remConn then CurrentMapRemConn = nil end
            if remConn then remConn:Disconnect(); remConn = nil end
            if CurrentMapCcConn == ccConn then CurrentMapCcConn = nil end
            if ccConn then ccConn:Disconnect(); ccConn = nil end
            CleanupMap(child)
        end
    end)
    CurrentMapRemConn = remConn
    if remConn then RegisterConnection(remConn) end

    -- Автоматическое измерение и сохранение размера новой карты
    RecordMapSizeIfNew(child)

    -- Высота сейф-зоны по карте (до спавна монет и до ТП игроков, считается один раз за карту)
    task.spawn(function()
        local y = ComputeMapSafeY(child)
        if CurrentMapInstance == child then
            CurrentMapSafeY = y
        end
    end)

    -- Одноразовый safe-телепорт: ждём ТП игрока из лобби на эту карту
    StartSafeZoneWatch()
end

local function InspectMapCandidate(child: Instance)
    if not IsMapCandidate(child) then return end
    if CurrentMapInstance == child then return end

    local container = child:FindFirstChild("CoinContainer")
    local spawns = child:FindFirstChild("Spawns")

    if container or spawns then
        DisconnectCandidate(child)
        RegisterMap(child, spawns, container)
        return
    end

    if not candidateConnections[child] then
        candidateConnections[child] = {}

        local addConn = child.ChildAdded:Connect(function(newChild)
            if newChild.Name == "Spawns" or newChild.Name == "CoinContainer" then
                DisconnectCandidate(child)
                if not IsTerminated and child.Parent == Workspace and CurrentMapInstance ~= child then
                    local s = (newChild.Name == "Spawns") and newChild or child:FindFirstChild("Spawns")
                    local c = (newChild.Name == "CoinContainer") and newChild or child:FindFirstChild("CoinContainer")
                    RegisterMap(child, s, c)
                end
            end
        end)
        table.insert(candidateConnections[child], addConn)

        local ancConn = child.AncestryChanged:Connect(function(_, parent)
            if not parent or parent ~= Workspace then
                DisconnectCandidate(child)
            end
        end)
        table.insert(candidateConnections[child], ancConn)

        -- Автоматическое снятие временных слушателей через 15 с, если у объекта так и не появились Spawns / CoinContainer
        task.delay(15, function()
            DisconnectCandidate(child)
        end)
    end
end

local function DoForceCheckMap()
    if CurrentMapInstance and CurrentMapInstance.Parent == Workspace then return end
    for _, ch in ipairs(Workspace:GetChildren()) do
        if IsMapCandidate(ch) and CurrentMapInstance ~= ch then
            InspectMapCandidate(ch)
            if CurrentMapInstance then break end
        end
    end
end

for _, ch in ipairs(Workspace:GetChildren()) do
    InspectMapCandidate(ch)
end

RegisterConnection(Workspace.ChildAdded:Connect(function(child)
    if IsTerminated then return end
    task.defer(function()
        InspectMapCandidate(child)
    end)
end))

RegisterConnection(Workspace.ChildRemoved:Connect(function(child)
    CleanupMap(child)
end))

