-- ПОИСК СЕТЕВЫХ СОБЫТИЙ (REMOTE EVENT FINDER)
-- =====================================================================
-- Кэш найденных ремоутов (положительные результаты живут, пока ремоут в дереве; "не найден" помним 30 с,
-- чтобы не сканировать весь ReplicatedStorage при каждом вызове)
local RemoteCache: { [string]: RemoteEvent } = {}
local RemoteMissUntil: { [string]: number } = {}

local function FindRemoteEvent(name: string): RemoteEvent?
    local cached = RemoteCache[name]
    if cached and cached.Parent then return cached end
    RemoteCache[name] = nil

    local missUntil = RemoteMissUntil[name]
    if missUntil and os.clock() < missUntil then return nil end

    local found: RemoteEvent? = nil
    local direct = ReplicatedStorage:FindFirstChild(name)
    if direct and direct:IsA("RemoteEvent") then
        found = direct
    else
        local deep = ReplicatedStorage:FindFirstChild(name, true)
        if deep and deep:IsA("RemoteEvent") then
            found = deep
        else
            for _, item in ipairs(ReplicatedStorage:GetDescendants()) do
                if item:IsA("RemoteEvent") and item.Name == name then
                    found = item
                    break
                end
            end
        end
    end

    if found then
        RemoteCache[name] = found
        RemoteMissUntil[name] = nil
    else
        RemoteMissUntil[name] = os.clock() + 30
    end
    return found
end

-- Сетевые кэши состояния раунда и игроков
local PlayerRolesCache: { [string]: string } = {}
local PlayerAliveCache: { [string]: boolean } = {} -- true = мертв, false = жив

-- Проверка статуса смерти игрока (в игре существует только атрибут/поле Dead):
-- true  -> мертв / не в раунде в любом случае
-- false -> полноценно жив в раунде
-- nil   -> таблица не обновилась или персонаж в лобби
local function GetPlayerDeadStatus(plr: Player?): boolean?
    local target = plr or LocalPlayer

    -- 1. Атрибут Dead на объекте Player (если игра его вешает)
    local attrDead = target:GetAttribute("Dead")
    if attrDead ~= nil then
        return (attrDead == true)
    end

    -- 2. Серверный сетевой кэш PlayerAliveCache (RoundStart / PlayerDataChanged)
    local cached = PlayerAliveCache[target.Name]
    if cached ~= nil then
        return cached
    end

    return nil
end

local function HasAssignedRole(plr: Player?): boolean
    local target = plr or LocalPlayer
    local role = PlayerRolesCache[target.Name]
    return (role ~= nil and role ~= "" and role ~= "nil")
end

local function IsPlayerActuallyAlive(plr: Player): boolean
    local char = plr.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end

    -- Строгая проверка через статус смерти (Dead / Death / PlayerAliveCache):
    -- true  -> Мёртв / не в раунде (false)
    -- false -> В раунде и жив (true)
    -- nil   -> Не участвует в раунде (зритель / в лобби) (false)
    local deadStatus = GetPlayerDeadStatus(plr)
    return (deadStatus == false)
end

-- Безопасная swap-and-pop очистка отключенных соединений из массива ActiveConnections (O(1) на удаление)
local function PruneActiveConnections()
    local connIdx = 1
    while connIdx <= #ActiveConnections do
        local conn = ActiveConnections[connIdx]
        if not conn or not conn.Connected then
            ActiveConnections[connIdx] = ActiveConnections[#ActiveConnections]
            ActiveConnections[#ActiveConnections] = nil
        else
            connIdx = connIdx + 1
        end
    end
end

local function AutoFarmCleanUp()
