local function InspectDeviceButton(btnInstance: Instance, name: string)
    Log(string.format("🔍 [DEVICE] Обнаружена кнопка [%s]: класс = %s", name, btnInstance.ClassName), "DATA")
    
    if btnInstance:IsA("GuiObject") then
        local absPos = btnInstance.AbsolutePosition
        local absSize = btnInstance.AbsoluteSize
        Log(string.format("📐 [%s] Visible: %s | Active: %s | AbsolutePos: (%d, %d) | AbsoluteSize: (%d, %d)", 
            name, tostring(btnInstance.Visible), tostring(btnInstance.Active), absPos.X, absPos.Y, absSize.X, absSize.Y), "DATA")
    end

    -- Проверка getconnections на различные события
    local gc = getconnections or (syn and syn.getconnections)
    if typeof(gc) == "function" then
        local eventsToCheck = {"MouseButton1Click", "MouseButton1Down", "Activated", "TouchTap", "InputBegan"}
        for _, evName in ipairs(eventsToCheck) do
            local hasSignal, signal = pcall(function() return (btnInstance :: any)[evName] end)
            if hasSignal and signal then
                local ok, conns = pcall(gc, signal)
                if ok and typeof(conns) == "table" then
                    Log(string.format("⚡ [%s.%s] Слушателей (listeners): %d", name, evName, #conns), #conns > 0 and "DATA" or "INFO")
                end
            end
        end
    else
        Log(string.format("⚠️ [DEVICE] getconnections недоступен в эксплойте", name), "WARN")
    end

    -- Список дочерних элементов (Icon, Title, Switch, Last и т.д.)
    local childrenDesc = {}
    for _, ch in ipairs(btnInstance:GetChildren()) do
        local extra = ""
        if ch:IsA("TextLabel") or ch:IsA("TextButton") then
            extra = string.format(" [Text: '%s', Vis: %s]", ch.Text, tostring(ch.Visible))
        elseif ch:IsA("ImageLabel") or ch:IsA("ImageButton") then
            extra = string.format(" [Image: '%s', Vis: %s]", ch.Image, tostring(ch.Visible))
        end
        table.insert(childrenDesc, string.format("%s (%s)%s", ch.Name, ch.ClassName, extra))
    end
    if #childrenDesc > 0 then
        Log(string.format("📁 [%s] Дети: %s", name, table.concat(childrenDesc, ", ")), "INFO")
    end

    -- Слушаем нажатия пользователя на эту кнопку
    if btnInstance:IsA("GuiObject") then
        local inpConn = btnInstance.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                Log(string.format("👆 [DEVICE CLICK] Физическое нажатие на [%s]! UserInputType: %s", name, tostring(input.UserInputType.Name)), "DATA")
            end
        end)
        table.insert(activeConnections, inpConn)
    end
end

local function InspectDeviceSelectGui(gui: Instance)
    Log(string.format("📱 [DEVICE] Найден интерфейс выбора устройства: %s (%s)", gui.Name, gui.ClassName), "DATA")
    
    local container = gui:FindFirstChild("Container")
