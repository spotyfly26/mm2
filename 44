-- 8. PlayerDataChanged: Глобальная серверная таблица (Монеты ВСЕХ игроков, роли, статус жизни)
-- MM2 рассылает ВСЕМ клиентам сводную таблицу игроков ПРИ ИГРОВЫХ СОБЫТИЯХ (смерти игроков)!
RegisterRemoteHook("PlayerDataChanged", function(data: any)
    if typeof(data) ~= "table" then
        Log("[PlayerDataChanged] Получены данные не-табличного типа: " .. tostring(data), "DATA")
        return
    end

    local countPlayers = 0
    local coinDeltas = {}
    local roleDeltas = {}
    local deathDeltas = {}

    for pName, pInfo in pairs(data) do
        countPlayers = countPlayers + 1
        local playerName = tostring(pName)

        if typeof(pInfo) == "table" then
            -- Монеты
            if pInfo.Coins ~= nil then
                local currentCoins = tonumber(pInfo.Coins) or 0
                local prevCoins = PlayerCoinsCache[playerName]
                if prevCoins ~= nil and currentCoins ~= prevCoins then
                    local diff = currentCoins - prevCoins
                    table.insert(coinDeltas, string.format("%s (%+d -> %d)", playerName, diff, currentCoins))
                    if playerName == LocalPlayer.Name then
                        Log(string.format("🎯 [МОЙ ИГРОК: PlayerData] Сервер обновил монеты: %+d (стало %d)", diff, currentCoins), "PLAYER")
                    end
                end
                PlayerCoinsCache[playerName] = currentCoins
            end

            -- Роли
            if pInfo.Role ~= nil then
                local r = tostring(pInfo.Role)
                local prevR = PlayerRolesCache[playerName]
                if prevR ~= nil and r ~= prevR then
                    table.insert(roleDeltas, string.format("%s: %s -> %s", playerName, prevR, r))
                end
                PlayerRolesCache[playerName] = r
            end

            -- Смерти (Dead)
            if pInfo.Dead ~= nil then
                local isDead = (pInfo.Dead == true)
                local prevDead = PlayerAliveCache[playerName]
                if prevDead ~= nil and isDead ~= prevDead then
                    table.insert(deathDeltas, string.format("%s: %s", playerName, isDead and "МЁРТВ" or "ЖИВ"))
                end
                PlayerAliveCache[playerName] = isDead
            end
        end
    end

    if #coinDeltas > 0 then
        Log("🪙 [PlayerData: МОНЕТЫ] " .. table.concat(coinDeltas, ", "), "COIN")
    end
    if #roleDeltas > 0 then
        Log("🎭 [PlayerData: РОЛИ] " .. table.concat(roleDeltas, ", "), "DATA")
    end
    if #deathDeltas > 0 then
        Log("⚰️ [PlayerData: СТАТУС] " .. table.concat(deathDeltas, ", "), "DATA")
    end

    UpdateLocalPlayerDisplay()
    UpdatePlayersPanel()

    -- Если пришёл пустой словарь {} — это сброс состояния между раундами!
    if countPlayers == 0 then
        Log("🔄 [PlayerDataChanged] Таблица игроков ОЧИЩЕНА сервером (Сброс между раундами)", "DATA")
        table.clear(PlayerCoinsCache)
        table.clear(PlayerRolesCache)
        table.clear(PlayerAliveCache)
        UpdateLocalPlayerDisplay()
        UpdatePlayersPanel()
    end
end)

-- =====================================================================
-- ТРЕКЕР КАРТЫ И МОНЕТ В WORKSPACE
-- =====================================================================
local CurrentMapInstance: Instance? = nil
local CurrentCoinContainer: Instance? = nil
local coinSpawnTracked = false
local mapSpawnTick = 0
local currentCoinCount = 0

local function CheckCoinContainerCoins(container: Instance): number
    local count = 0
    for _, desc in ipairs(container:GetDescendants()) do
        if desc:IsA("TouchTransmitter") and desc.Parent and desc.Parent:IsA("BasePart") then
            count = count + 1
        end
    end
    return count
end

local function HookCoinContainer(coinContainer: Instance)
    if CurrentCoinContainer == coinContainer then return end
    CurrentCoinContainer = coinContainer
    currentCoinCount = CheckCoinContainerCoins(coinContainer)
    if currentCoinCount > 0 then
        coinSpawnTracked = true
    end
    LblCoinsInfo.Text = string.format("Монеты: %d на карте", currentCoinCount)

    local spawnDelta = (mapSpawnTick > 0) and string.format("(через %.2fc после карты)", tick() - mapSpawnTick) or ""
    Log(string.format("🟡 [CoinContainer] Обнаружен! Стартовое число монет: %d %s", currentCoinCount, spawnDelta), "COIN")

    -- Отслеживаем добавление монет инкрементно (без O(N^2) обхода дерева)
    local addConn = coinContainer.DescendantAdded:Connect(function(desc)
        if desc:IsA("TouchTransmitter") then
            currentCoinCount = currentCoinCount + 1
            if not coinSpawnTracked then
                coinSpawnTracked = true
                local d = (mapSpawnTick > 0) and string.format("(через %.2fc после спавна карты)", tick() - mapSpawnTick) or ""
                Log(string.format("✨ [МОНЕТЫ] НАЧАЛСЯ СПАВН МОНЕТ на карте! %s", d), "COIN")
            end
            LblCoinsInfo.Text = string.format("Монеты: %d на карте", currentCoinCount)
        end
    end)
    table.insert(activeConnections, addConn)

    -- Отслеживаем удаление монет (подбор) декрементно
    local remConn = coinContainer.ChildRemoved:Connect(function()
        currentCoinCount = math.max(0, currentCoinCount - 1)
        LblCoinsInfo.Text = string.format("Монеты: %d на карте", currentCoinCount)
    end)
    table.insert(activeConnections, remConn)

    -- Отслеживаем уничтожение контейнера (защита от дубликатов лога)
    local ancConn = coinContainer.AncestryChanged:Connect(function(_, parent)
        if not parent and CurrentCoinContainer == coinContainer then
            CurrentCoinContainer = nil
            currentCoinCount = 0
            coinSpawnTracked = false
            Log("❌ [CoinContainer] УДАЛЁН из Workspace!", "COIN")
            LblCoinsInfo.Text = "Монеты: 0 (контейнер удален)"
        end
    end)
    table.insert(activeConnections, ancConn)
end

local function IsMapCandidate(child: Instance): boolean
    if not child:IsA("Model") and not child:IsA("Folder") then return false end
    if child == LocalPlayer.Character or (child:IsA("Model") and Players:GetPlayerFromCharacter(child)) then return false end
    if child.Name == "Lobby" or child.Name == "Terrain" or child.Name == "Camera" then return false end
    if child.Name == "RaycastFilter" or child.Name == "GunDrop" then return false end
    return true
end

local candidateConnections: { [Instance]: { RBXScriptConnection } } = {}

local function DisconnectCandidate(child: Instance)
    local conns = candidateConnections[child]
    if conns then
        for _, c in ipairs(conns) do
            if c and c.Connected then pcall(function() c:Disconnect() end) end
        end
        candidateConnections[child] = nil
    end
end

local function CleanupMap(child: Instance)
    DisconnectCandidate(child)
    if CurrentMapInstance == child then
        local lifetime = (mapSpawnTick > 0) and string.format("(жила %.1fc)", tick() - mapSpawnTick) or ""
        Log(string.format("🧹 [КАРТА] ОЧИСТКА КАРТЫ: '%s' удалена из Workspace %s", child.Name, lifetime), "MAP")
        CurrentMapInstance = nil
        CurrentCoinContainer = nil
        currentCoinCount = 0
        coinSpawnTracked = false
        mapSpawnTick = 0
        LblCurrentMap.Text = "Карта: (нет)"
        LblCurrentMap.TextColor3 = Color3.fromRGB(180, 180, 180)
        UpdateLocalPlayerDisplay()
        UpdatePlayersPanel()
    end
end

local function RegisterMap(child: Instance, spawns: Instance?, container: Instance?)
    if CurrentMapInstance == child then return end
    CurrentMapInstance = child
    mapSpawnTick = tick()
    coinSpawnTracked = false

    LblCurrentMap.Text = "Карта: " .. child.Name
    LblCurrentMap.TextColor3 = Color3.fromRGB(100, 255, 150)
    LblRoundStatus.Text = "Раунд: ИДЁТ (Карта на сервере)"
    LblRoundStatus.TextColor3 = Color3.fromRGB(100, 255, 120)

    EndVoting("Спавн карты '" .. child.Name .. "'")
    Log(string.format("🗺️ [КАРТА] СПАВН КАРТЫ: '%s' (Класс: %s, Spawns=%s, CoinContainer=%s)", 
        child.Name, child.ClassName, tostring(spawns ~= nil), tostring(container ~= nil)), "MAP")

    if container then
        HookCoinContainer(container)
    else
        -- Ждем появления CoinContainer, если он загружается следом
        local ccConn: RBXScriptConnection? = nil
        ccConn = child.ChildAdded:Connect(function(newChild)
            if newChild.Name == "CoinContainer" then
                if ccConn then
                    ccConn:Disconnect()
                    ccConn = nil
                end
                HookCoinContainer(newChild)
            end
        end)
        if ccConn then table.insert(activeConnections, ccConn) end

        -- Дополнительный фоновый WaitForChild на случай задержки сетевой репликации
        task.spawn(function()
            local cc = child:WaitForChild("CoinContainer", 15)
            if cc and not CurrentCoinContainer and CurrentMapInstance == child then
                HookCoinContainer(cc)
            end
        end)
    end

    local remConn = child.AncestryChanged:Connect(function(_, parent)
        if not parent or parent ~= Workspace then
            CleanupMap(child)
        end
    end)
    table.insert(activeConnections, remConn)
end

local function InspectMapCandidate(child: Instance)
    if not IsMapCandidate(child) then return end
    if CurrentMapInstance == child then return end

    local container = child:FindFirstChild("CoinContainer")
    local spawns = child:FindFirstChild("Spawns")

    if container or spawns then
        DisconnectCandidate(child)
        RegisterMap(child, spawns, container)
        return
    end

    -- Если папки Spawns/CoinContainer ещё реплицируются по сети:
    -- Подключаем мгновенный слушатель ChildAdded на модель-кандидат (без жесткого ограничения по времени)
    if not candidateConnections[child] then
        candidateConnections[child] = {}

        local addConn = child.ChildAdded:Connect(function(newChild)
            if newChild.Name == "Spawns" or newChild.Name == "CoinContainer" then
                DisconnectCandidate(child)
                if not isTerminated and child.Parent == Workspace and CurrentMapInstance ~= child then
                    local s = (newChild.Name == "Spawns") and newChild or child:FindFirstChild("Spawns")
                    local c = (newChild.Name == "CoinContainer") and newChild or child:FindFirstChild("CoinContainer")
                    RegisterMap(child, s, c)
                end
            end
        end)
        table.insert(candidateConnections[child], addConn)
        table.insert(activeConnections, addConn)

        local ancConn = child.AncestryChanged:Connect(function(_, parent)
            if not parent or parent ~= Workspace then
                DisconnectCandidate(child)
            end
        end)
        table.insert(candidateConnections[child], ancConn)
        table.insert(activeConnections, ancConn)

        -- Фоновое ожидание с увеличенным до 15 сек таймаутом на случай задержки сетевых пакетов
        task.spawn(function()
            local foundSpawns = child:WaitForChild("Spawns", 15)
            local foundContainer = child:FindFirstChild("CoinContainer")
            if not isTerminated and child.Parent == Workspace and (foundSpawns or foundContainer) then
                DisconnectCandidate(child)
                if CurrentMapInstance ~= child then
                    RegisterMap(child, foundSpawns, foundContainer)
                end
            end
        end)
    end
end

local function DoForceCheckMap()
    if CurrentMapInstance and CurrentMapInstance.Parent == Workspace then return end
    for _, ch in ipairs(Workspace:GetChildren()) do
        if IsMapCandidate(ch) and CurrentMapInstance ~= ch then
            InspectMapCandidate(ch)
            if CurrentMapInstance then break end
            -- Резерв: если раунд начат, а Spawns/CoinContainer ещё задерживаются,
            -- любая модель-кандидат с деталями гарантированно является активной картой
            if not CurrentMapInstance and ch:IsA("Model") and #ch:GetChildren() > 5 then
                RegisterMap(ch, ch:FindFirstChild("Spawns"), ch:FindFirstChild("CoinContainer"))
                break
            end
        end
    end
end
ForceCheckMap = DoForceCheckMap

-- Моментальная O(1) проверка карты: не сканируем Workspace:GetChildren() каждые 0.5с
local function GetWorkspaceMap(): Instance?
    if CurrentMapInstance and CurrentMapInstance.Parent == Workspace then
        return CurrentMapInstance
    end
    return nil
end

-- =====================================================================
-- УНИВЕРСАЛЬНАЯ ПРОВЕРКА НАХОЖДЕНИЯ В РАУНДЕ
-- =====================================================================
local function IsPlayerAliveInRound(plr: Player?): boolean
    local player = plr or LocalPlayer
    -- 1. Карта раунда должна быть в Workspace (не в лобби)
    if not GetWorkspaceMap() then return false end

    -- 2. Физический персонаж должен существовать и иметь здоровье
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end

    -- 3. Серверная проверка: игрок участник раунда и не мертв
    if PlayerAliveCache[player.Name] == false then
        return true
    end

    -- Резерв для классических режимов
    return player:GetAttribute("Alive") == true
end

-- Сканируем уже существующие карты в Workspace при запуске
for _, ch in ipairs(Workspace:GetChildren()) do
    InspectMapCandidate(ch)
end

-- Слушаем появление новых карт
local wsAddConn = Workspace.ChildAdded:Connect(function(child)
    if isTerminated then return end
    task.defer(function()
        InspectMapCandidate(child)
    end)
end)
table.insert(activeConnections, wsAddConn)

-- Слушаем удаление карты из Workspace
local wsRemConn = Workspace.ChildRemoved:Connect(function(child)
    CleanupMap(child)
end)
table.insert(activeConnections, wsRemConn)

