        if isTerminated or not gui.Parent then return end
        Log("🧪 [DEVICE TEST] Пробуем автоматический выбор 'Tablet'...", "WARN")
        
        local targetBtn = tablet or phone
        if not targetBtn then return end

        local targetName = targetBtn.Name
        local gc = getconnections or (syn and syn.getconnections)

        -- Метод 1: getconnections на Activated / MouseButton1Click
        if typeof(gc) == "function" then
            for _, evName in ipairs({"Activated", "MouseButton1Click"}) do
                local sOk, sig = pcall(function() return (targetBtn :: any)[evName] end)
                if sOk and sig then
                    local cOk, conns = pcall(gc, sig)
                    if cOk and typeof(conns) == "table" and #conns > 0 then
                        Log(string.format("⚡ [TEST 1] Вызываем %d слушателей %s.%s:Fire()...", #conns, targetName, evName), "INFO")
                        for _, c in ipairs(conns) do
                            pcall(function() c:Fire() end)
                        end
                    end
                end
            end
        end

        -- Метод 2: firesignal (если доступно)
        local fs = firesignal or (syn and syn.firesignal)
        if typeof(fs) == "function" then
            pcall(function()
                if (targetBtn :: any).Activated then
                    fs((targetBtn :: any).Activated)
                    Log("⚡ [TEST 2] Вызван firesignal(Activated)", "INFO")
                end
                if (targetBtn :: any).MouseButton1Click then
                    fs((targetBtn :: any).MouseButton1Click)
                    Log("⚡ [TEST 2] Вызван firesignal(MouseButton1Click)", "INFO")
                end
            end)
        end

        -- Метод 3: VirtualInputManager (клик по AbsolutePosition)
        if targetBtn:IsA("GuiObject") then
            local vim = game:GetService("VirtualInputManager")
            local absPos = targetBtn.AbsolutePosition
            local absSize = targetBtn.AbsoluteSize
            local cx = absPos.X + absSize.X / 2
            local cy = absPos.Y + absSize.Y / 2
            pcall(function()
                Log(string.format("🖱 [TEST 3] Эмуляция клика VirtualInputManager по (%d, %d)...", cx, cy), "INFO")
                vim:SendMouseButtonEvent(cx, cy, 0, true, game, 0)
                task.wait(0.05)
                vim:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
            end)
        end

        -- Проверка результата через 1 секунду
        task.wait(1)
        if not gui.Parent or not (gui:IsA("ScreenGui") and gui.Enabled) or not (container:IsA("GuiObject") and container.Visible) then
            Log("🎉 [DEVICE TEST РЕЗУЛЬТАТ] Меню выбора УСПЕШНО закрылось! Автовыбор работает!", "DATA")
        else
            Log("ℹ️ [DEVICE TEST РЕЗУЛЬТАТ] Меню все еще открыто. Нажмите на Tablet/Phone вручную — клик и сетевые запросы будут записаны.", "WARN")
        end
    end)
