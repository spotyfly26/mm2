local logCounter = 0
local rawLogLines: { string } = {}

local function Log(message: string, msgCategory: string?)
    if isTerminated then return end
    logCounter = logCounter + 1

    local color = Color3.fromRGB(200, 200, 200)
    local prefix = "[INFO]"

    if msgCategory == "ROUND" then
        color = Color3.fromRGB(255, 110, 110)
        prefix = "[ROUND]"
    elseif msgCategory == "MAP" then
        color = Color3.fromRGB(120, 200, 255)
        prefix = "[MAP]"
    elseif msgCategory == "COIN" then
        color = Color3.fromRGB(255, 215, 60)
        prefix = "[COIN]"
    elseif msgCategory == "VOTE" then
        color = Color3.fromRGB(170, 120, 255)
        prefix = "[VOTE]"
    elseif msgCategory == "REMOTE" then
        color = Color3.fromRGB(255, 145, 50)
        prefix = "[REMOTE]"
    elseif msgCategory == "DATA" then
        color = Color3.fromRGB(130, 255, 170)
        prefix = "[DATA]"
    elseif msgCategory == "KILL" then
        color = Color3.fromRGB(255, 70, 180)
        prefix = "[KILL]"
    elseif msgCategory == "PLAYER" then
        color = Color3.fromRGB(110, 255, 230)
        prefix = "[PLAYER]"
    elseif msgCategory == "WARN" then
        color = Color3.fromRGB(255, 180, 50)
        prefix = "[WARN]"
    elseif msgCategory == "ERROR" then
        color = Color3.fromRGB(255, 75, 75)
        prefix = "[ERR]"
    end

    local timeStr = os.date("%H:%M:%S")
    local lineText = string.format("%s %s %s", timeStr, prefix, message)
    table.insert(rawLogLines, lineText)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -6, 0, 0)
    lbl.AutomaticSize = Enum.AutomaticSize.Y
    lbl.BackgroundTransparency = 1
    lbl.Text = lineText
    lbl.TextColor3 = color
    lbl.Font = Enum.Font.Code
    lbl.TextSize = 10
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextWrapped = true
    lbl.LayoutOrder = logCounter
    lbl.Parent = LogScroll

    -- Авто-скролл вниз
    task.defer(function()
        LogScroll.CanvasPosition = Vector2.new(0, 999999)
    end)
end

local function ClearLogs()
    for _, child in ipairs(LogScroll:GetChildren()) do
        if child:IsA("TextLabel") then child:Destroy() end
    end
    table.clear(rawLogLines)
    logCounter = 0
    Log("Логи очищены.", "INFO")
end

BtnClear.MouseButton1Click:Connect(ClearLogs)

-- Экспорт лога в файл и буфер обмена
local function ExportLogsToFile()
    if #rawLogLines == 0 then
        Log("Лог пуст — нечего экспортировать", "WARN")
        return
    end

    local fileName = "mm2_round_diagnostic.txt"
    local content = table.concat(rawLogLines, "\n")
    local wf = writefile or (syn and syn.writefile)

    if typeof(wf) == "function" then
        local ok, err = pcall(wf, fileName, content)
        if ok then
            Log(string.format("✅ Лог записан в файл: %s (%d строк)", fileName, #rawLogLines), "DATA")
        else
            Log("❌ Ошибка записи файла: " .. tostring(err), "ERROR")
        end
    else
        Log("⚠️ Функция writefile недоступна в этом эксплойте", "WARN")
    end
end

local function CopyLogsToClipboard(sourceBtn: TextButton?): boolean
    if #rawLogLines == 0 then
        Log("Лог пуст — нечего копировать", "WARN")
        return false
    end
    local content = table.concat(rawLogLines, "\n")
    local sc = setclipboard or toclipboard or (syn and syn.write_clipboard) or (Clipboard and Clipboard.set)
    local copied = false
    if typeof(sc) == "function" then
        local ok, err = pcall(sc, content)
        if ok then
            copied = true
            Log(string.format("📋 Лог скопирован в буфер обмена (%d строк)", #rawLogLines), "DATA")
        else
            Log("❌ Ошибка буфера: " .. tostring(err), "ERROR")
        end
    else
        Log("⚠️ Функция setclipboard недоступна в этом эксплойте", "WARN")
    end

    if sourceBtn then
        local origText = sourceBtn.Text
        local origBg = sourceBtn.BackgroundColor3
        sourceBtn.Text = copied and (sourceBtn == CopyTitleBtn and "✅" or "✅ СКОПИРОВАНО!") or "⚠️ ОШИБКА"
        sourceBtn.BackgroundColor3 = copied and Color3.fromRGB(40, 160, 80) or Color3.fromRGB(180, 60, 60)
        task.delay(1.5, function()
            if not isTerminated and sourceBtn and sourceBtn.Parent then
                sourceBtn.Text = origText
                sourceBtn.BackgroundColor3 = origBg
            end
        end)
    end

    return copied
end

local function BindButton(btn: TextButton, callback: () -> ())
    local debounce = false
    local function fire()
        if debounce or isTerminated then return end
        debounce = true
        task.spawn(callback)
        task.delay(0.2, function() debounce = false end)
    end
    btn.MouseButton1Click:Connect(fire)
    btn.TouchTap:Connect(fire)
end

