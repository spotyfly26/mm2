-- Кэш GUI и TextLabel для подиумов голосования (чтобы избежать рекурсивного сканирования каждые 0.5с)
type PadCacheEntry = {
    gui: Instance?,
    textLabels: { TextLabel },
}
local padCache: { [Instance]: PadCacheEntry } = {}

-- Проверка активности подиума голосования и извлечение данных с диагностикой метода скрытия
local function GetPadVoteInfo(pad: Instance): (string?, number?, string)
    local cached = padCache[pad]
    local infoGui = cached and cached.gui

    if not infoGui or not infoGui.Parent then
        infoGui = pad:FindFirstChild("VoteInfoGui", true)
        if not infoGui then
            return nil, 0, "VoteInfoGui удалён (nil)"
        end
        local labels: { TextLabel } = {}
        for _, desc in ipairs(infoGui:GetDescendants()) do
            if desc:IsA("TextLabel") then
                table.insert(labels, desc)
            end
        end
        cached = {
            gui = infoGui,
            textLabels = labels,
        }
        padCache[pad] = cached
    end

    -- 1. Свойство Enabled у SurfaceGui/BillboardGui
    if (infoGui:IsA("SurfaceGui") or infoGui:IsA("BillboardGui") or infoGui:IsA("ScreenGui")) and not (infoGui :: any).Enabled then
        return nil, 0, "VoteInfoGui.Enabled = false"
    end

    local mapName: string? = nil
    local votes = 0
    local anyTextLabelFound = false
    local hiddenReason = "Нет видимых TextLabel"

    for _, desc in ipairs(cached.textLabels) do
        if desc.Parent then
            anyTextLabelFound = true

            if not desc.Visible then
                hiddenReason = string.format("TextLabel '%s'.Visible = false", desc.Name)
            elseif desc.TextTransparency >= 1 then
                hiddenReason = string.format("TextLabel '%s'.TextTransparency = 1", desc.Name)
            else
                -- Проверяем видимость родительских контейнеров (Frame, CanvasGroup)
                local isParentVisible = true
                local parent = desc.Parent
                while parent and parent ~= infoGui do
                    if parent:IsA("GuiObject") then
                        if not parent.Visible then
                            isParentVisible = false
                            hiddenReason = string.format("Родитель '%s' (%s).Visible = false", parent.Name, parent.ClassName)
                            break
                        end
                        if parent:IsA("CanvasGroup") and (parent :: CanvasGroup).GroupTransparency >= 1 then
                            isParentVisible = false
                            hiddenReason = string.format("CanvasGroup '%s'.GroupTransparency = 1", parent.Name)
                            break
                        end
                    end
                    parent = parent.Parent
                end

                if isParentVisible then
                    local cleanText = string.gsub(desc.Text, "^%s*(.-)%s*$", "%1")
                    local lower = string.lower(cleanText)
                    if cleanText ~= "" and lower ~= "label" then
                        if string.find(lower, "votes") then
                            local num = tonumber(string.match(cleanText, "%d+"))
                            if num then votes = num end
                        else
                            if desc.Name == "MapName" or not mapName then
                                mapName = cleanText
                            end
                        end
                    else
                        hiddenReason = string.format("TextLabel '%s'.Text пустой", desc.Name)
                    end
                end
            end
        end
    end

    if mapName and mapName ~= "" then
        return mapName, votes, "Активен"
    end

    if not anyTextLabelFound then
        hiddenReason = "Внутри VoteInfoGui нет TextLabel"
    end

    return nil, 0, hiddenReason
end

local hookedPads: { [Instance]: boolean } = {}

local function HookVotePadEvents(pad: Instance, onStateChange: () -> ())
    if hookedPads[pad] then return end
    hookedPads[pad] = true

    local function TryHookGui(infoGui: Instance)
        if infoGui:IsA("SurfaceGui") or infoGui:IsA("BillboardGui") or infoGui:IsA("ScreenGui") then
            local conn = (infoGui :: any):GetPropertyChangedSignal("Enabled"):Connect(function()
                if not isTerminated then
                    onStateChange()
                end
            end)
            table.insert(activeConnections, conn)
        end
    end

    local existingGui = pad:FindFirstChild("VoteInfoGui", true)
    if existingGui then
        TryHookGui(existingGui)
    end

    local descConn = pad.DescendantAdded:Connect(function(desc)
        if desc.Name == "VoteInfoGui" then
            padCache[pad] = nil
            TryHookGui(desc)
            onStateChange()
        elseif desc:IsA("TextLabel") then
            padCache[pad] = nil
        end
    end)
    table.insert(activeConnections, descConn)
end

local function CheckVotingState()
    -- 1. Если в Workspace есть карта — голосование НЕ активно в любом случае
    local currentMap = GetWorkspaceMap()
    if currentMap ~= nil then
        if isVotingActive then
            EndVoting("В Workspace активна карта '" .. currentMap.Name .. "'")
        else
            if LblVoteStatus.Text ~= "Голосование: Не активно" then
                LblVoteStatus.Text = "Голосование: Не активно"
                LblVoteStatus.TextColor3 = Color3.fromRGB(150, 180, 210)
            end
        end
        return
    end

    -- 2. Карты в Workspace нет — проверяем лобби и VotePads
    local lobby = Workspace:FindFirstChild("Lobby")
    local votePadsFolder = lobby and lobby:FindFirstChild("VotePads")

    if not votePadsFolder then
        if isVotingActive then
            EndVoting("VotePads не найдены в лобби")
        end
        return
    end

    local currentMapNames = {}
    local totalVotes = 0
    local padReasons = {}

    for _, pad in ipairs(votePadsFolder:GetChildren()) do
        if pad:IsA("BasePart") or pad:IsA("Model") then
            HookVotePadEvents(pad, CheckVotingState)
            local mapName, votes, reason = GetPadVoteInfo(pad)
            if mapName and mapName ~= "" then
                table.insert(currentMapNames, string.format("%s (%d гол.)", mapName, votes))
                totalVotes = totalVotes + votes
            else
                table.insert(padReasons, pad.Name .. ": " .. reason)
            end
        end
    end

    if #currentMapNames > 0 then
        table.sort(currentMapNames)
        local optionsStr = table.concat(currentMapNames, " | ")

        if not isVotingActive or optionsStr ~= lastVoteOptions then
            if not isVotingActive then
                Log(string.format("🗳️ [ГОЛОСОВАНИЕ] НАЧАЛОСЬ ГОЛОСОВАНИЕ ЗА КАРТЫ! Варианты: %s", optionsStr), "VOTE")
            else
                Log(string.format("🗳️ [ГОЛОСОВАНИЕ: ОБНОВЛЕНИЕ] %s (Всего голосов: %d)", optionsStr, totalVotes), "VOTE")
            end
            isVotingActive = true
            lastVoteOptions = optionsStr
            LblVoteStatus.Text = "Голосование: " .. optionsStr
            LblVoteStatus.TextColor3 = Color3.fromRGB(180, 120, 255)
            if LblRoundStatus.Text == "Раунд: Ожидание" or string.find(LblRoundStatus.Text, "ЗАВЕРШЁН") then
                LblRoundStatus.Text = "Раунд: Голосование"
                LblRoundStatus.TextColor3 = Color3.fromRGB(200, 140, 255)
            end
        end
    else
        if isVotingActive then
            local uniqueMethods = {}
            local seenMethods = {}
            for _, r in ipairs(padReasons) do
                local method = string.match(r, ": (.*)$") or r
                if not seenMethods[method] then
                    seenMethods[method] = true
                    table.insert(uniqueMethods, method)
                end
            end
            local methodSummary = #uniqueMethods > 0 and table.concat(uniqueMethods, " | ") or "VoteInfoGui отключен"
            EndVoting(string.format("Панели скрыты сервером [Метод: %s]", methodSummary))
        end
    end
end

