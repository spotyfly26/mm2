type PlayerCardUI = {
    card: Frame,
    stroke: UIStroke,
    statusIcon: TextLabel,
    nameLabel: TextLabel,
    subLabel: TextLabel,
}
local playerCardPool: { [string]: PlayerCardUI } = {}

local function DoUpdatePlayersPanel()
    if not PlayersSideFrame.Visible then return end

    local totalInRound = 0
    local aliveCount = 0
    local deadCount = 0

    local participantNames = {}
    for pName, _ in pairs(PlayerAliveCache) do
        table.insert(participantNames, pName)
    end

    if #participantNames == 0 then
        LblPlayersSummary.Text = "В лобби: раунд не начат"
        LblPlayersSummary.TextColor3 = Color3.fromRGB(160, 160, 180)
        for _, item in pairs(playerCardPool) do
            item.card.Visible = false
        end
        return
    end

    -- Сортировка: сначала живые, затем мертвые; LocalPlayer всегда первый
    table.sort(participantNames, function(a, b)
        if a == LocalPlayer.Name then return true end
        if b == LocalPlayer.Name then return false end
        local aDead = PlayerAliveCache[a] == true
        local bDead = PlayerAliveCache[b] == true
        if aDead ~= bDead then
            return not aDead
        end
        return string.lower(a) < string.lower(b)
    end)

    local activeNames: { [string]: boolean } = {}

    for idx, pName in ipairs(participantNames) do
        activeNames[pName] = true
        totalInRound = totalInRound + 1
        local isDead = PlayerAliveCache[pName] == true
        if isDead then
            deadCount = deadCount + 1
        else
            aliveCount = aliveCount + 1
        end

        local role = PlayerRolesCache[pName] or "None"
        local coins = PlayerCoinsCache[pName] or 0
        local isMe = (pName == LocalPlayer.Name)

        local item = playerCardPool[pName]
        if not item or not item.card.Parent then
            local card = Instance.new("Frame")
            card.Size = UDim2.new(1, -4, 0, 32)
            card.BorderSizePixel = 0
            Instance.new("UICorner", card).CornerRadius = UDim.new(0, 5)

            local stroke = Instance.new("UIStroke", card)
            stroke.Thickness = 1

            local statusIcon = Instance.new("TextLabel")
            statusIcon.Size = UDim2.new(0, 18, 1, 0)
            statusIcon.Position = UDim2.new(0, 4, 0, 0)
            statusIcon.BackgroundTransparency = 1
            statusIcon.TextSize = 11
            statusIcon.Parent = card

            local nameLabel = Instance.new("TextLabel")
            nameLabel.Size = UDim2.new(1, -26, 0, 14)
            nameLabel.Position = UDim2.new(0, 24, 0, 2)
            nameLabel.BackgroundTransparency = 1
            nameLabel.Font = Enum.Font.GothamBold
            nameLabel.TextSize = 10
            nameLabel.TextXAlignment = Enum.TextXAlignment.Left
            nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
            nameLabel.Parent = card

            local subLabel = Instance.new("TextLabel")
            subLabel.Size = UDim2.new(1, -26, 0, 12)
            subLabel.Position = UDim2.new(0, 24, 0, 16)
            subLabel.BackgroundTransparency = 1
            subLabel.Font = Enum.Font.Gotham
            subLabel.TextSize = 9
            subLabel.TextXAlignment = Enum.TextXAlignment.Left
            subLabel.Parent = card

            card.Parent = PlayersScroll

            item = {
                card = card,
                stroke = stroke,
                statusIcon = statusIcon,
                nameLabel = nameLabel,
                subLabel = subLabel,
            }
            playerCardPool[pName] = item
        end

        item.card.Visible = true
        item.card.LayoutOrder = idx
        item.card.BackgroundColor3 = isMe and Color3.fromRGB(24, 38, 52) or Color3.fromRGB(20, 22, 30)
        item.stroke.Color = isMe and Color3.fromRGB(60, 140, 200) or (isDead and Color3.fromRGB(50, 40, 45) or Color3.fromRGB(45, 65, 50))

        item.statusIcon.Text = isDead and "💀" or "🟢"
        item.nameLabel.Text = pName .. (isMe and " (ВЫ)" or "")
        item.nameLabel.TextColor3 = isDead and Color3.fromRGB(150, 150, 150) or (isMe and Color3.fromRGB(100, 220, 255) or Color3.fromRGB(235, 235, 245))

        local roleColor = Color3.fromRGB(170, 170, 180)
        if role == "Murderer" or role == "Zombie" then
            roleColor = Color3.fromRGB(255, 90, 90)
        elseif role == "Sheriff" or role == "Hero" then
            roleColor = Color3.fromRGB(90, 160, 255)
        elseif role == "Assassin" then
            roleColor = Color3.fromRGB(255, 170, 70)
        elseif role == "Survivor" or role == "Innocent" then
            roleColor = Color3.fromRGB(100, 230, 130)
        end

        item.subLabel.Text = string.format("%s | 🪙 %d", role, coins)
        item.subLabel.TextColor3 = roleColor
    end

    -- Скрываем карточки тех, кого больше нет в раунде
    for pName, item in pairs(playerCardPool) do
        if not activeNames[pName] then
            item.card.Visible = false
        end
    end

    LblPlayersSummary.Text = string.format("Живых: %d | Погибло: %d | Всего: %d", aliveCount, deadCount, totalInRound)
    LblPlayersSummary.TextColor3 = aliveCount > 0 and Color3.fromRGB(100, 255, 150) or Color3.fromRGB(255, 100, 100)
end
