        Log("⚠️ [DEVICE] 'Container' не найден внутри DeviceSelect. Ищем детей...", "WARN")
        for _, ch in ipairs(gui:GetChildren()) do
            Log(string.format("  • %s (%s)", ch.Name, ch.ClassName), "INFO")
        end
        return
    end

    Log(string.format("📦 [DEVICE] Container найден (класс: %s, Visible: %s)", container.ClassName, tostring((container :: any).Visible)), "DATA")
    
    local tablet = container:FindFirstChild("Tablet")
    local phone = container:FindFirstChild("Phone")
    
    if tablet then
        InspectDeviceButton(tablet, "Tablet")
    else
        Log("⚠️ [DEVICE] Кнопка Tablet не найдена в Container", "WARN")
    end
    
    if phone then
        InspectDeviceButton(phone, "Phone")
