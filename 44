-- =====================================================================
-- СЕРИАЛИЗАТОР АРГУМЕНТОВ РЕМОУТОВ
-- =====================================================================
local function SerializeArg(v: any, depth: number?): string
    depth = depth or 0
    if depth > 2 then return "..." end
    local t = typeof(v)
    if t == "string" then
        return '"' .. tostring(v):sub(1, 100) .. '"'
    elseif t == "number" or t == "boolean" then
        return tostring(v)
    elseif t == "nil" then
        return "nil"
    elseif t == "Instance" then
        local ok, path = pcall(function() return v:GetFullName() end)
        return "[" .. v.ClassName .. "] " .. (ok and path or v.Name)
    elseif t == "table" then
        local parts = {}
        local count = 0
        for k, val in pairs(v) do
            count = count + 1
            if count > 8 then table.insert(parts, "..."); break end
            table.insert(parts, tostring(k) .. "=" .. SerializeArg(val, depth + 1))
        end
        return "{" .. table.concat(parts, ", ") .. "}"
    else
        return t .. "(" .. tostring(v):sub(1, 40) .. ")"
    end
end

local function SerializeArgs(...): string
    local n = select("#", ...)
    if n == 0 then return "(без параметров)" end
    local parts = {}
    for i = 1, n do
        local v = select(i, ...)
        table.insert(parts, "#" .. i .. ": " .. SerializeArg(v))
    end
    return table.concat(parts, " | ")
end

-- =====================================================================
-- ПОИСК REMOTEEVENT
-- =====================================================================
local function FindRemoteEvent(name: string): RemoteEvent?
    local direct = ReplicatedStorage:FindFirstChild(name)
    if direct and direct:IsA("RemoteEvent") then return direct end
    local deep = ReplicatedStorage:FindFirstChild(name, true)
    if deep and deep:IsA("RemoteEvent") then return deep end
    for _, item in ipairs(ReplicatedStorage:GetDescendants()) do
        if item:IsA("RemoteEvent") and item.Name == name then
            return item
        end
    end
    return nil
end

